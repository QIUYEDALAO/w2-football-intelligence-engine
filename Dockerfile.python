ARG UV_BOOTSTRAP_IMAGE=ghcr.io/astral-sh/uv:0.11.30
FROM ${UV_BOOTSTRAP_IMAGE} AS uv-bootstrap
FROM python:3.12-slim
ARG PIP_INDEX_URL=
ARG UV_INDEX_URL=
ENV VIRTUAL_ENV=/app/.venv
ENV PATH=/app/.venv/bin:$PATH \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    UV_INDEX_URL=${UV_INDEX_URL} \
    UV_HTTP_TIMEOUT=30 \
    UV_HTTP_RETRIES=2
WORKDIR /app
RUN useradd --create-home --uid 10001 w2
COPY --from=uv-bootstrap /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock README.md ./
RUN uv --version && uv sync --no-dev --frozen --no-editable --no-install-project
COPY alembic.ini ./
COPY apps ./apps
COPY src ./src
COPY config ./config
COPY migrations ./migrations
# Runtime script allowlist: model-validation canary and guarded xG lineage repair.
COPY scripts/run_w2_free_mode_model_validation_canary.py ./scripts/
COPY scripts/repair_w2_xg_retention_lineage.py ./scripts/
COPY config/policies/lineup_market_policy.v1.json /app/image_config/policies/lineup_market_policy.v1.json
# Build input only. The wheel's force-include reads this one file and ships it as
# w2/dashboard/data/, which is what the dashboard loads at runtime; the tree is
# removed again below so nothing can fall back to reading docs/ out of the image.
COPY docs/review_packages/SC21_FACTOR_INPUT_CHAIN/SC21_FACTOR_ROLE_AUTHORITY_MATRIX.json \
     ./docs/review_packages/SC21_FACTOR_INPUT_CHAIN/SC21_FACTOR_ROLE_AUTHORITY_MATRIX.json
RUN uv sync --no-dev --frozen --no-editable \
 && test -f /app/.venv/lib/python3.12/site-packages/w2/dashboard/data/SC21_FACTOR_ROLE_AUTHORITY_MATRIX.json \
 && rm -rf /app/docs \
 && test ! -e /app/docs \
 && test -x /app/.venv/bin/alembic \
 && test -x /app/.venv/bin/w2-gate5-preflight \
 && test -x /app/.venv/bin/w2-shadow-comparison-import \
 && test -x /app/.venv/bin/w2-stage7i-observer \
 && test -x /app/.venv/bin/w2-finished-match-scoring
ARG W2_GIT_SHA=UNKNOWN
ARG W2_BUILD_TIME=UNKNOWN
ARG W2_RELEASE_ID=${W2_GIT_SHA}
ENV W2_GIT_SHA=${W2_GIT_SHA} \
    W2_BUILD_TIME=${W2_BUILD_TIME} \
    W2_RELEASE_ID=${W2_RELEASE_ID}
LABEL org.opencontainers.image.source="w2-football-intelligence-engine" \
      org.opencontainers.image.revision="${W2_GIT_SHA}" \
      org.opencontainers.image.created="${W2_BUILD_TIME}" \
      w2.release.id="${W2_RELEASE_ID}" \
      w2.runtime.contract.version="release-train-2-patch2"
USER w2
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=2)"
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
