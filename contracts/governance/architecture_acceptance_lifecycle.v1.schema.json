{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "w2.architecture_acceptance_lifecycle.v1",
  "title": "W2 architecture acceptance lifecycle artifact",
  "oneOf": [
    {"$ref": "#/$defs/spec"},
    {"$ref": "#/$defs/baseline_receipt"},
    {"$ref": "#/$defs/final_attestation"},
    {"$ref": "#/$defs/evidence_artifact"},
    {"$ref": "#/$defs/raw_measurement_receipt_set"},
    {"$ref": "#/$defs/detached_result"},
    {"$ref": "#/$defs/evidence_index"}
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "allowed", "forbidden", "sha256"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "allowed": {"$ref": "#/$defs/non_empty_string_array"},
        "forbidden": {"$ref": "#/$defs/non_empty_string_array"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "change_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rationale"],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {"enum": ["REVIEW_MISS", "SCOPE_AMENDMENT"]}
            },
            "required": ["kind"]
          },
          "then": {"required": ["supersedes_spec_sha256"]}
        }
      ],
      "properties": {
        "kind": {
          "enum": ["INITIAL_FREEZE", "REVIEW_MISS", "SCOPE_AMENDMENT"]
        },
        "rationale": {"type": "string", "minLength": 1},
        "supersedes_spec_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inventory_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "kind", "file_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/repo_path"},
        "kind": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "reachability": {
          "enum": ["PRODUCTION_REACHABLE", "NO_PRODUCTION_CALLER", "UNKNOWN"]
        },
        "reachability_rationale": {"type": "string", "minLength": 1}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_points",
        "producers",
        "consumers",
        "storage",
        "scripts",
        "config_paths"
      ],
      "properties": {
        "entry_points": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inventory_item"}
        },
        "producers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inventory_item"}
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inventory_item"}
        },
        "storage": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inventory_item"}
        },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inventory_item"}
        },
        "config_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inventory_item"}
        }
      }
    },
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "accepted_evidence_types",
        "shape",
        "shape_sha256",
        "redaction"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "accepted_evidence_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "REAL_DB",
              "REAL_PRODUCER_OUTPUT",
              "CONTENT_ADDRESSED_SANITIZED_ARTIFACT"
            ]
          }
        },
        "shape": {"type": "object", "minProperties": 1},
        "shape_sha256": {"$ref": "#/$defs/sha256"},
        "redaction": {"type": "string", "minLength": 1}
      }
    },
    "alias_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "exact_mapping", "reject"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "exact_mapping": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        },
        "reject": {"$ref": "#/$defs/non_empty_string_array"}
      }
    },
    "case_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source_input_id",
        "derivation",
        "expected_output",
        "fail_closed",
        "forbidden_behaviors"
      ],
      "properties": {
        "type": {
          "enum": ["valid", "missing", "malformed", "stale", "ambiguous", "conflict"]
        },
        "source_input_id": {"type": "string", "minLength": 1},
        "derivation": {
          "enum": ["UNCHANGED_REAL_INPUT", "CONTROLLED_MUTATION_OF_SANITIZED_REAL_INPUT"]
        },
        "expected_output": {"type": "string", "minLength": 1},
        "fail_closed": {"const": true},
        "forbidden_behaviors": {"$ref": "#/$defs/non_empty_string_array"}
      }
    },
    "claim_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "applicability", "rationale"],
      "properties": {
        "name": {
          "enum": [
            "DEAD_CODE",
            "ZERO_REACHABILITY",
            "SINGLE_AUTHORITY",
            "ZERO_LEGACY_READ_WRITE",
            "SAFE_DELETION"
          ]
        },
        "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "frozen_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "forbidden"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "requirement": {"type": "string", "minLength": 1},
        "forbidden": {"$ref": "#/$defs/non_empty_string_array"}
      }
    },
    "measurement_plan_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_id",
        "target_kind",
        "target_id",
        "argv",
        "command_sha256",
        "expected_evidence_path",
        "evidence_type",
        "output_schema",
        "subject_head",
        "generator",
        "allowed_exit_codes",
        "fingerprint_rule"
      ],
      "oneOf": [
        {
          "required": ["pytest_nodeid"],
          "not": {"required": ["checker_symbol"]}
        },
        {
          "required": ["checker_symbol"],
          "not": {"required": ["pytest_nodeid"]}
        }
      ],
      "properties": {
        "measurement_id": {"type": "string", "pattern": "^[A-Z0-9_:-]+$"},
        "target_kind": {
          "enum": ["FROZEN_ASSERTION", "INPUT", "CASE", "LAYER", "CLAIM"]
        },
        "target_id": {"type": "string", "minLength": 1},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "command_sha256": {"$ref": "#/$defs/sha256"},
        "pytest_nodeid": {"type": "string", "pattern": "^.+\\.py::.+$"},
        "checker_symbol": {"type": "string", "minLength": 1},
        "expected_evidence_path": {"$ref": "#/$defs/repo_path"},
        "evidence_type": {
          "enum": [
            "STATIC_AST_SCAN",
            "RUNTIME_SQL_TRACE",
            "MUTATION_TEST",
            "REAL_DB",
            "REAL_PRODUCER_OUTPUT",
            "CONTENT_ADDRESSED_SANITIZED_ARTIFACT"
          ]
        },
        "output_schema": {"type": "object", "minProperties": 1},
        "subject_head": {"const": "IMPLEMENTATION_EXACT_HEAD"},
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "symbol", "file_sha256"],
          "properties": {
            "path": {"$ref": "#/$defs/repo_path"},
            "symbol": {"type": "string", "minLength": 1},
            "file_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "allowed_exit_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 255}
        },
        "fingerprint_rule": {"const": "EVIDENCE_RESULT_FINGERPRINT"}
      }
    },
    "primary_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "test",
        "producer",
        "consumer",
        "required_input_types",
        "handwritten_primary_forbidden"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/repo_path"},
        "test": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "consumer": {"type": "string", "minLength": 1},
        "required_input_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "REAL_DB",
              "REAL_PRODUCER_OUTPUT",
              "CONTENT_ADDRESSED_SANITIZED_ARTIFACT"
            ]
          }
        },
        "handwritten_primary_forbidden": {"const": true}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "schema_path",
        "artifact_kind",
        "task_id",
        "frozen_baseline_commit",
        "change_control",
        "scope",
        "inventory",
        "input_contracts",
        "alias_rules",
        "cases",
        "claims",
        "required_evidence_layers",
        "primary_contract",
        "frozen_assertions",
        "measurement_plan",
        "review_policy",
        "spec_sha256"
      ],
      "properties": {
        "schema_version": {"const": "w2.architecture_acceptance_lifecycle.v1"},
        "schema_path": {
          "const": "contracts/governance/architecture_acceptance_lifecycle.v1.schema.json"
        },
        "artifact_kind": {"const": "IMMUTABLE_SPEC"},
        "task_id": {"type": "string", "pattern": "^ARCH-[A-Z0-9-]+$"},
        "frozen_baseline_commit": {"$ref": "#/$defs/sha"},
        "change_control": {"$ref": "#/$defs/change_control"},
        "scope": {"$ref": "#/$defs/scope"},
        "inventory": {"$ref": "#/$defs/inventory"},
        "input_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/input_contract"}
        },
        "alias_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/alias_rule"}
        },
        "cases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/case_spec"}
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/claim_spec"}
        },
        "required_evidence_layers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["STATIC_AST", "RUNTIME_SQL_TRACE", "MUTATION_TESTS"]}
        },
        "primary_contract": {"$ref": "#/$defs/primary_contract"},
        "frozen_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/frozen_assertion"}
        },
        "measurement_plan": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/measurement_plan_item"}
        },
        "review_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "immutable_during_implementation_and_closure",
            "scope_change_pr_kind",
            "post_implementation_review",
            "old_head_first_miss_label"
          ],
          "properties": {
            "immutable_during_implementation_and_closure": {"const": true},
            "scope_change_pr_kind": {"const": "PREFLIGHT"},
            "post_implementation_review": {
              "const": "FROZEN_ASSERTIONS_AND_NEW_DIFF_REGRESSIONS_ONLY"
            },
            "old_head_first_miss_label": {"const": "REVIEW_MISS"}
          }
        },
        "spec_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_type",
        "role",
        "artifact_path",
        "artifact_sha256",
        "command",
        "subject_head"
      ],
      "properties": {
        "evidence_type": {
          "enum": [
            "STATIC_AST_SCAN",
            "RUNTIME_SQL_TRACE",
            "MUTATION_TEST",
            "SYNTHETIC_CONTRACT_TEST",
            "DECLARED_ORM_SCHEMA",
            "REAL_DB",
            "REAL_PRODUCER_OUTPUT",
            "CONTENT_ADDRESSED_SANITIZED_ARTIFACT"
          ]
        },
        "role": {"enum": ["PRIMARY", "SUPPORTING"]},
        "artifact_path": {"$ref": "#/$defs/repo_path"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "command": {"type": "string", "minLength": 1},
        "subject_head": {"$ref": "#/$defs/sha"},
        "consumes_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "mutation_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "layer_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "rationale"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "PARTIAL", "UNVERIFIABLE", "BLOCKED"]},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_item"}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "precondition_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "rationale"],
      "properties": {
        "status": {"enum": ["PASS", "BLOCKED", "UNVERIFIABLE"]},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_item"}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "input_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "status", "evidence_type", "evidence", "rationale"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "UNVERIFIABLE", "BLOCKED"]},
        "evidence_type": {
          "enum": [
            "REAL_DB",
            "REAL_PRODUCER_OUTPUT",
            "CONTENT_ADDRESSED_SANITIZED_ARTIFACT",
            "DECLARED_ORM_SCHEMA",
            "SYNTHETIC_CONTRACT_TEST"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_item"}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status", "derivation", "observed_output", "evidence"],
      "allOf": [
        {
          "if": {
            "properties": {
              "derivation": {
                "const": "CONTROLLED_MUTATION_OF_SANITIZED_REAL_INPUT"
              }
            },
            "required": ["derivation"]
          },
          "then": {
            "required": [
              "source_artifact_sha256",
              "mutation_manifest",
              "mutation_manifest_sha256",
              "mutation_operation",
              "expected_output",
              "observed_output_fingerprint"
            ]
          }
        }
      ],
      "properties": {
        "type": {
          "enum": ["valid", "missing", "malformed", "stale", "ambiguous", "conflict"]
        },
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "UNVERIFIABLE", "BLOCKED"]},
        "derivation": {
          "enum": [
            "UNCHANGED_REAL_INPUT",
            "CONTROLLED_MUTATION_OF_SANITIZED_REAL_INPUT"
          ]
        },
        "observed_output": {"type": "string", "minLength": 1},
        "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "mutation_manifest": {"type": "object", "minProperties": 1},
        "mutation_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "mutation_operation": {"type": "string", "minLength": 1},
        "expected_output": {"type": "string", "minLength": 1},
        "observed_output_fingerprint": {"$ref": "#/$defs/sha256"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_item"}
        }
      }
    },
    "claim_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "rationale", "layer_evidence"],
      "properties": {
        "name": {
          "enum": [
            "DEAD_CODE",
            "ZERO_REACHABILITY",
            "SINGLE_AUTHORITY",
            "ZERO_LEGACY_READ_WRITE",
            "SAFE_DELETION"
          ]
        },
        "status": {
          "enum": ["PASS", "FAIL", "UNVERIFIABLE", "BLOCKED", "NOT_APPLICABLE"]
        },
        "rationale": {"type": "string", "minLength": 1},
        "layer_evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "STATIC_AST": {
              "type": "array",
              "items": {"$ref": "#/$defs/evidence_item"}
            },
            "RUNTIME_SQL_TRACE": {
              "type": "array",
              "items": {"$ref": "#/$defs/evidence_item"}
            },
            "MUTATION_TESTS": {
              "type": "array",
              "items": {"$ref": "#/$defs/evidence_item"}
            }
          }
        }
      }
    },
    "receipt_common_properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "schema_path",
        "artifact_kind",
        "task_id",
        "spec_path",
        "spec_sha256",
        "subject_head",
        "preconditions",
        "implementation_open_status",
        "input_results",
        "layer_results",
        "case_results",
        "claim_results",
        "overall_status",
        "receipt_sha256"
      ],
      "properties": {
        "schema_version": {"const": "w2.architecture_acceptance_lifecycle.v1"},
        "schema_path": {
          "const": "contracts/governance/architecture_acceptance_lifecycle.v1.schema.json"
        },
        "artifact_kind": {"const": "BASELINE_RECEIPT"},
        "task_id": {"type": "string", "pattern": "^ARCH-[A-Z0-9-]+$"},
        "spec_path": {"$ref": "#/$defs/repo_path"},
        "spec_sha256": {"$ref": "#/$defs/sha256"},
        "subject_head": {"$ref": "#/$defs/sha"},
        "preconditions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "SPEC_INVENTORY_COMPLETE",
            "REAL_INPUT_AVAILABLE",
            "RUNTIME_SQL_BASELINE_CAPTURED",
            "MUTATION_SOURCE_FROZEN",
            "GENERATOR_REPLAYABLE",
            "SCOPE_AND_FORBIDDEN_FROZEN"
          ],
          "properties": {
            "SPEC_INVENTORY_COMPLETE": {"$ref": "#/$defs/precondition_result"},
            "REAL_INPUT_AVAILABLE": {"$ref": "#/$defs/precondition_result"},
            "RUNTIME_SQL_BASELINE_CAPTURED": {"$ref": "#/$defs/precondition_result"},
            "MUTATION_SOURCE_FROZEN": {"$ref": "#/$defs/precondition_result"},
            "GENERATOR_REPLAYABLE": {"$ref": "#/$defs/precondition_result"},
            "SCOPE_AND_FORBIDDEN_FROZEN": {"$ref": "#/$defs/precondition_result"}
          }
        },
        "implementation_open_status": {"enum": ["OPEN", "BLOCKED"]},
        "input_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/input_result"}
        },
        "layer_results": {
          "type": "object",
          "additionalProperties": false,
          "required": ["STATIC_AST", "RUNTIME_SQL_TRACE", "MUTATION_TESTS"],
          "properties": {
            "STATIC_AST": {"$ref": "#/$defs/layer_result"},
            "RUNTIME_SQL_TRACE": {"$ref": "#/$defs/layer_result"},
            "MUTATION_TESTS": {"$ref": "#/$defs/layer_result"}
          }
        },
        "case_results": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/case_result"}
        },
        "claim_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/claim_result"}
        },
        "overall_status": {"enum": ["PASS", "FAIL", "UNVERIFIABLE", "BLOCKED"]},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "baseline_receipt": {
      "allOf": [
        {"$ref": "#/$defs/receipt_common_properties"},
        {
          "type": "object",
          "properties": {
            "artifact_kind": {"const": "BASELINE_RECEIPT"}
          }
        }
      ]
    },
    "final_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "schema_path",
        "artifact_kind",
        "task_id",
        "subject_head",
        "implementation_pr_number",
        "implementation_merge_sha",
        "full_ci_run_id",
        "external_review_sha256",
        "spec_sha256",
        "baseline_receipt_sha256",
        "result_zip_sha256",
        "evidence_zip_sha256",
        "result_content_sha256",
        "evidence_content_sha256",
        "detached_result",
        "evidence_index",
        "attested_at",
        "attestation_sha256"
      ],
      "properties": {
        "schema_version": {"const": "w2.architecture_acceptance_lifecycle.v1"},
        "schema_path": {
          "const": "contracts/governance/architecture_acceptance_lifecycle.v1.schema.json"
        },
        "artifact_kind": {"const": "FINAL_ATTESTATION"},
        "task_id": {"type": "string", "pattern": "^ARCH-[A-Z0-9-]+$"},
        "subject_head": {"$ref": "#/$defs/sha"},
        "implementation_pr_number": {"type": "integer", "minimum": 1},
        "implementation_merge_sha": {"$ref": "#/$defs/sha"},
        "full_ci_run_id": {"type": "integer", "minimum": 1},
        "external_review_sha256": {"$ref": "#/$defs/sha256"},
        "spec_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "result_zip_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_zip_sha256": {"$ref": "#/$defs/sha256"},
        "result_content_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_content_sha256": {"$ref": "#/$defs/sha256"},
        "detached_result": {"$ref": "#/$defs/detached_result"},
        "evidence_index": {"$ref": "#/$defs/evidence_index"},
        "attested_at": {"type": "string", "format": "date-time"},
        "attestation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "frozen_assertion_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "rationale"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "UNVERIFIABLE", "BLOCKED"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "detached_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "task_id",
        "subject_head",
        "spec_sha256",
        "baseline_receipt_sha256",
        "full_ci_run_id",
        "frozen_assertion_results",
        "input_results",
        "case_results",
        "layer_results",
        "claim_results",
        "evidence_index_sha256",
        "result_sha256"
      ],
      "properties": {
        "artifact_kind": {"const": "DETACHED_IMPLEMENTATION_RESULT"},
        "task_id": {"type": "string", "pattern": "^ARCH-[A-Z0-9-]+$"},
        "subject_head": {"$ref": "#/$defs/sha"},
        "spec_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "full_ci_run_id": {"type": "integer", "minimum": 1},
        "frozen_assertion_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/frozen_assertion_result"}
        },
        "input_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/input_result"}
        },
        "case_results": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/case_result"}
        },
        "layer_results": {
          "type": "object",
          "additionalProperties": false,
          "required": ["STATIC_AST", "RUNTIME_SQL_TRACE", "MUTATION_TESTS"],
          "properties": {
            "STATIC_AST": {"$ref": "#/$defs/layer_result"},
            "RUNTIME_SQL_TRACE": {"$ref": "#/$defs/layer_result"},
            "MUTATION_TESTS": {"$ref": "#/$defs/layer_result"}
          }
        },
        "claim_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/claim_result"}
        },
        "evidence_index_sha256": {"$ref": "#/$defs/sha256"},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "raw_measurement_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_id",
        "argv",
        "command_sha256",
        "exit_code",
        "executed_nodeids",
        "passed_count",
        "failed_count",
        "skipped_count",
        "stdout_sha256",
        "stderr_sha256",
        "evidence_artifact_path",
        "evidence_artifact_sha256",
        "evidence_generated_by_command_sha256",
        "observed_output_fingerprint"
      ],
      "properties": {
        "measurement_id": {"type": "string", "pattern": "^[A-Z0-9_:-]+$"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "command_sha256": {"$ref": "#/$defs/sha256"},
        "exit_code": {"type": "integer"},
        "executed_nodeids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "passed_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "skipped_count": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_artifact_path": {"$ref": "#/$defs/repo_path"},
        "evidence_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_generated_by_command_sha256": {"$ref": "#/$defs/sha256"},
        "mutation_source_sha256": {"$ref": "#/$defs/sha256"},
        "mutation_manifest": {"type": "object", "minProperties": 1},
        "mutation_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "mutation_operation": {"type": "string", "minLength": 1},
        "observed_output_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "raw_measurement_receipt_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "task_id",
        "subject_head",
        "full_ci_run_id",
        "measurements",
        "evidence_artifacts",
        "raw_receipt_sha256"
      ],
      "properties": {
        "artifact_kind": {"const": "RAW_MEASUREMENT_RECEIPT_SET"},
        "task_id": {"type": "string", "pattern": "^ARCH-[A-Z0-9-]+$"},
        "subject_head": {"$ref": "#/$defs/sha"},
        "full_ci_run_id": {"type": "integer", "minimum": 1},
        "measurements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/raw_measurement_receipt"}
        },
        "evidence_artifacts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "task_id",
              "subject_head",
              "measurement_id",
              "command_sha256",
              "result_fingerprint"
            ],
            "properties": {
              "task_id": {"type": "string"},
              "subject_head": {"$ref": "#/$defs/sha"},
              "measurement_id": {"type": "string"},
              "command_sha256": {"$ref": "#/$defs/sha256"},
              "result_fingerprint": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "raw_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_index_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "task_id",
        "subject_head",
        "canonical_payload_sha256",
        "use"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/repo_path"},
        "task_id": {"type": "string", "pattern": "^ARCH-[A-Z0-9-]+$"},
        "subject_head": {"$ref": "#/$defs/sha"},
        "canonical_payload_sha256": {"$ref": "#/$defs/sha256"},
        "use": {"type": "string", "minLength": 1}
      }
    },
    "evidence_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "task_id",
        "subject_head",
        "evidence",
        "index_sha256"
      ],
      "properties": {
        "artifact_kind": {"const": "DETACHED_EVIDENCE_INDEX"},
        "task_id": {"type": "string", "pattern": "^ARCH-[A-Z0-9-]+$"},
        "subject_head": {"$ref": "#/$defs/sha"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_index_entry"}
        },
        "index_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "schema_path",
        "artifact_kind",
        "task_id",
        "generator",
        "replay",
        "migration_head",
        "captured_at",
        "source_identity",
        "row_count",
        "result_fingerprint",
        "provider_call_delta",
        "db_write_delta",
        "subject_head",
        "artifact_sha256"
      ],
      "properties": {
        "schema_version": {"const": "w2.architecture_acceptance_lifecycle.v1"},
        "schema_path": {
          "const": "contracts/governance/architecture_acceptance_lifecycle.v1.schema.json"
        },
        "artifact_kind": {
          "enum": [
            "REAL_DB_EVIDENCE",
            "REAL_PRODUCER_OUTPUT_EVIDENCE",
            "CONTENT_ADDRESSED_SANITIZED_ARTIFACT_EVIDENCE"
          ]
        },
        "task_id": {"type": "string", "pattern": "^ARCH-[A-Z0-9-]+$"},
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "symbol", "file_sha256"],
          "properties": {
            "path": {"$ref": "#/$defs/repo_path"},
            "symbol": {"type": "string", "minLength": 1},
            "file_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv", "command_sha256", "output_flag"],
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 2,
              "items": {"type": "string", "minLength": 1}
            },
            "command_sha256": {"$ref": "#/$defs/sha256"},
            "output_flag": {"const": "--output"},
            "query": {"type": "string", "minLength": 1},
            "query_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "migration_head": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "format": "date-time"},
        "source_identity": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": ["string", "integer"]}
        },
        "row_count": {"type": "integer", "minimum": 0},
        "result_fingerprint": {"$ref": "#/$defs/sha256"},
        "provider_call_delta": {"type": "integer", "minimum": 0},
        "db_write_delta": {"type": "integer", "minimum": 0},
        "subject_head": {"$ref": "#/$defs/sha"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"artifact_kind": {"const": "REAL_DB_EVIDENCE"}},
            "required": ["artifact_kind"]
          },
          "then": {
            "properties": {
              "replay": {"required": ["query", "query_sha256"]},
              "db_write_delta": {"const": 0}
            }
          }
        }
      ]
    }
  }
}
