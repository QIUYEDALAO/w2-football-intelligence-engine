{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "w2.architecture_acceptance_matrix.v1",
  "title": "W2 frozen architecture acceptance matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_path",
    "task_id",
    "task_status",
    "frozen_exact_head",
    "frozen_scope",
    "inventory",
    "input_shapes",
    "alias_rules",
    "cases",
    "evidence_layers",
    "claims",
    "primary_contract_tests",
    "supplementary_tests",
    "external_evidence",
    "review_policy",
    "implementation_gate",
    "matrix_sha256"
  ],
  "properties": {
    "schema_version": {"const": "w2.architecture_acceptance_matrix.v1"},
    "schema_path": {
      "const": "contracts/governance/architecture_acceptance_matrix.v1.schema.json"
    },
    "task_id": {"type": "string", "pattern": "^ARCH-[A-Z0-9-]+$"},
    "task_status": {
      "enum": ["NOT_STARTED", "IN_PROGRESS", "IMPLEMENTED_PENDING_ACCEPTANCE", "BLOCKED", "DONE"]
    },
    "frozen_exact_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "frozen_scope": {
      "type": "object",
      "required": ["summary", "allowed", "forbidden", "sha256"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "allowed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forbidden": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "required": ["entry_points", "producers", "consumers", "storage", "scripts", "config_paths"],
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["name", "path"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "symbol": {"type": "string"},
            "kind": {"type": "string"},
            "frozen_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      }
    },
    "input_shapes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "origin", "source_path", "source_sha256", "shape", "shape_sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "origin": {"enum": ["REAL_PRODUCER_OUTPUT", "REAL_DB", "TRACKED_REAL_ARTIFACT"]},
          "source_path": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "shape": {"type": "object"},
          "shape_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "redaction": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "alias_rules": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "cases": {"type": "array", "minItems": 6, "items": {"type": "object"}},
    "evidence_layers": {"type": "object"},
    "claims": {"type": "array", "minItems": 5, "items": {"type": "object"}},
    "primary_contract_tests": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "supplementary_tests": {"type": "array", "items": {"type": "object"}},
    "external_evidence": {"type": "object"},
    "review_policy": {"type": "object"},
    "implementation_gate": {"type": "string", "minLength": 1},
    "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
