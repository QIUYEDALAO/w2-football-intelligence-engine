        "request": {"operation": "eval_02b_bootstrap_seed", "domain": "eval_02b.bootstrap_seed", "serializer_version": "w2.canonical-json.v2", "contract_version": "eval-02b-v1", "validation_pair_identity_hashes": ["not-a-hash"]},
        "expected": {"status": "error", "error_code": "INVALID_PAIR_IDENTITY_HASH"}
      }]
