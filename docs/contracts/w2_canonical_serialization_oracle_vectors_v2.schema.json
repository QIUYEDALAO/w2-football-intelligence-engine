          {"key": "canonical_fixture_id", "value": {"kind": "string", "value": "fixture-123"}},
          {"key": "competition_id", "value": {"kind": "string", "value": "competition-1"}},
          {"key": "season_id", "value": {"kind": "string", "value": "season-2026"}},
          {"key": "provider_id", "value": {"kind": "string", "value": "provider-a"}},
          {"key": "bookmaker_id", "value": {"kind": "string", "value": "bookmaker-1"}},
          {"key": "market", "value": {"kind": "string", "value": "ASIAN_HANDICAP"}},
          {"key": "selection", "value": {"kind": "string", "value": "HOME"}},
          {"key": "exact_line", "value": {"kind": "float64", "binary64_hex": "bff0000000000000"}},
