        "request": {"operation": "canonical_serialize", "domain": "stage7i_supervision.event", "serializer_version": "w2.canonical-json.v1", "value": {"kind": "object", "entries": [
          {"key": "message", "value": {"kind": "string", "value": "监督事件"}},
          {"key": "fallback", "value": {"kind": "unsupported", "type": "set"}}
        ]}},
        "expected": {"status": "success"}
      }]
    },
    "legacy_v1_pair_identity": {
      "variants": [{
        "request": {"operation": "canonical_serialize", "domain": "eval_02b.pair_identity", "serializer_version": "w2.canonical-json.v1", "value": {"kind": "object", "entries": [
          {"key": "canonical_fixture_id", "value": {"kind": "string", "value": "比赛-123"}},
          {"key": "competition_id", "value": {"kind": "string", "value": "competition-1"}},
          {"key": "season_id", "value": {"kind": "string", "value": "season-2026"}},
          {"key": "provider_id", "value": {"kind": "string", "value": "provider-a"}},
          {"key": "bookmaker_id", "value": {"kind": "string", "value": "bookmaker-1"}},
