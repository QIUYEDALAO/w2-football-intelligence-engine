{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w2.local/contracts/canonical-serialization-oracle-vectors-v2.schema.json",
  "title": "W2 canonical serialization independent oracle vectors v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "production_implementation_head",
    "adr_id",
    "serializer_version",
    "oracle_author",
    "oracle_imports_production_serializer",
    "review_status",
    "reviewer_records",
    "mandatory_case_matrix",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "w2.canonical-serialization-oracle-vectors.v2"},
    "production_implementation_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "adr_id": {"const": "ADR-0019"},
    "serializer_version": {"const": "w2.canonical-json.v2"},
    "oracle_author": {"type": "string", "minLength": 1},
    "oracle_imports_production_serializer": {"const": false},
    "review_status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUIRED"]},
    "reviewer_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer", "status", "recorded_at"],
        "properties": {
          "reviewer": {"type": "string", "minLength": 1},
          "status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUIRED"]},
          "recorded_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "mandatory_case_matrix": {
      "const": [
        "unicode_nfc",
        "unicode_key_collision",
        "large_decimal_context_independent",
        "float64_min_subnormal",
        "float64_max_finite",
        "float64_adjacent",
        "float64_power_of_ten_boundary",
        "float64_point_one",
        "float64_negative_zero",
        "float64_nan_rejected",
        "float64_infinity_rejected",
        "bytes",
        "aware_datetime",
        "naive_datetime_rejected",
        "unsupported_type_rejected",
        "reserved_tag_rejected",
        "legacy_v1_compatibility",
        "pair_identity",
        "bootstrap_order_independent",
        "invalid_pair_hash_rejected"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 22,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "category": {
      "enum": [
        "unicode_nfc",
        "unicode_key_collision",
        "large_decimal_context_independent",
        "float64_min_subnormal",
        "float64_max_finite",
        "float64_adjacent",
        "float64_power_of_ten_boundary",
        "float64_point_one",
        "float64_negative_zero",
        "float64_nan_rejected",
        "float64_infinity_rejected",
        "bytes",
        "aware_datetime",
        "naive_datetime_rejected",
        "unsupported_type_rejected",
        "reserved_tag_rejected",
        "legacy_v1_compatibility",
        "pair_identity",
        "bootstrap_order_independent",
        "invalid_pair_hash_rejected"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "category", "request", "oracle"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "category": {"$ref": "#/$defs/category"},
        "request": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "domain", "serializer_version", "value"],
              "properties": {
                "operation": {"const": "canonical_serialize"},
                "domain": {"const": "eval_02b.pair_identity"},
                "serializer_version": {"enum": ["w2.canonical-json.v1", "w2.canonical-json.v2"]},
                "value": {"$ref": "#/$defs/node"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "domain", "serializer_version", "contract_version", "validation_pair_identity_hashes"],
              "properties": {
                "operation": {"const": "eval_02b_bootstrap_seed"},
                "domain": {"const": "eval_02b.bootstrap_seed"},
                "serializer_version": {"const": "w2.canonical-json.v2"},
                "contract_version": {"type": "string", "minLength": 1},
                "validation_pair_identity_hashes": {"type": "array", "items": {"type": "string"}}
              }
            }
          ]
        },
        "oracle": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "canonical_utf8_hex", "sha256"],
              "properties": {
                "status": {"const": "success"},
                "canonical_utf8_hex": {"type": "string", "pattern": "^[0-9a-f]*$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "seed_payload_utf8_hex", "seed_hash", "bootstrap_seed"],
              "properties": {
                "status": {"const": "success"},
                "seed_payload_utf8_hex": {"type": "string", "pattern": "^[0-9a-f]*$"},
                "seed_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "bootstrap_seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "error_code"],
              "properties": {
                "status": {"const": "error"},
                "error_code": {"$ref": "#/$defs/error_code"}
              }
            }
          ]
        }
      }
    },
    "error_code": {
      "enum": [
        "UNSUPPORTED_SERIALIZER_VERSION",
        "NON_FINITE_FLOAT",
        "NON_FINITE_DECIMAL",
        "NAIVE_DATETIME",
        "NON_STRING_KEY",
        "RESERVED_TAG",
        "UNICODE_KEY_COLLISION",
        "UNSUPPORTED_TYPE",
        "LEGACY_DOMAIN_UNSUPPORTED",
        "HISTORICAL_HASH_MISMATCH",
        "BOOTSTRAP_CONTRACT_VERSION_REQUIRED",
        "INVALID_PAIR_IDENTITY_HASH"
      ]
    },
    "node": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "null"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "boolean"}, "value": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "integer"}, "value": {"type": "integer"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "binary64_hex"], "properties": {"kind": {"const": "float64"}, "binary64_hex": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "decimal"}, "value": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "string"}, "value": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "bytes"}, "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]*$"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "date"}, "value": {"type": "string", "format": "date"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "datetime"}, "value": {"type": "string", "format": "date-time"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "items"], "properties": {"kind": {"const": "array"}, "items": {"type": "array", "items": {"$ref": "#/$defs/node"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "entries"], "properties": {"kind": {"const": "object"}, "entries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"type": "string"}, "value": {"$ref": "#/$defs/node"}}}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "type"], "properties": {"kind": {"const": "unsupported"}, "type": {"const": "set"}}}
      ]
    }
  }
}
