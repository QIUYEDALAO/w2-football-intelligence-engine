        "request": {"operation": "canonical_serialize", "domain": "prematch_read_model.generic", "serializer_version": "w2.canonical-json.v1", "value": {"kind": "object", "entries": [
          {"key": "team", "value": {"kind": "string", "value": "上海"}},
          {"key": "price", "value": {"kind": "decimal", "value": "1.2300"}},
          {"key": "date", "value": {"kind": "date", "value": "2026-08-01"}},
