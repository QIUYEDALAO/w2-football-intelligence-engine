ARG W2_LOCAL_BASE_IMAGE
FROM ${W2_LOCAL_BASE_IMAGE}

ARG LOCAL_RELEASE_SHA
ARG LOCAL_RELEASE_TIME
USER root
COPY --chown=10001:10001 apps/scheduler /app/apps/scheduler
COPY --chown=10001:10001 src/w2 /app/src/w2
COPY --chown=10001:10001 src/w2 /app/.venv/lib/python3.12/site-packages/w2

ENV W2_GIT_SHA=${LOCAL_RELEASE_SHA} \
    W2_BUILD_TIME=${LOCAL_RELEASE_TIME} \
    W2_RELEASE_ID=${LOCAL_RELEASE_SHA}
LABEL org.opencontainers.image.revision="${LOCAL_RELEASE_SHA}" \
      org.opencontainers.image.created="${LOCAL_RELEASE_TIME}" \
      w2.release.id="${LOCAL_RELEASE_SHA}"
USER w2
