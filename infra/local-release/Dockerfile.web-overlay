ARG W2_LOCAL_BASE_IMAGE
FROM ${W2_LOCAL_BASE_IMAGE}

ARG LOCAL_RELEASE_SHA
ARG LOCAL_RELEASE_TIME
USER root
RUN printf '{\n  "web_git_sha": "%s",\n  "web_build_time": "%s",\n  "release_id": "%s",\n  "data_mode": "api"\n}\n' \
      "${LOCAL_RELEASE_SHA}" "${LOCAL_RELEASE_TIME}" "${LOCAL_RELEASE_SHA}" \
      > /usr/share/nginx/html/meta.json \
    && chown 101:101 /usr/share/nginx/html/meta.json
LABEL org.opencontainers.image.revision="${LOCAL_RELEASE_SHA}" \
      org.opencontainers.image.created="${LOCAL_RELEASE_TIME}" \
      w2.release.id="${LOCAL_RELEASE_SHA}"
USER 101
