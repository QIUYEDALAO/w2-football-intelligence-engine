#!/usr/bin/env bash
# Update only the existing read-only monitor; never invoke Provider or release.
set -euo pipefail

# F3 闸门（业务代码 tree sha 口径）：允许「业务代码 tree sha 与已部署 release 一致」的 commit 上巡检，
# 即纯运维变更（ops/host、tests 等）可领先 release，但业务代码（src/migrations/config/apps）未部署仍拒绝。
# 语义：防巡检跑「未部署的业务代码」，而非「巡检 commit sha == release sha」。
biz_tree_of() {
  local commit="$1" trees
  trees="$(git rev-parse "$commit:src" "$commit:migrations" "$commit:config" "$commit:apps")" || return 1
  printf '%s\n' "$trees" | git hash-object --stdin
}

# 被 source 时（单元测试），只暴露纯函数，不执行主流程。
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0 2>/dev/null || exit 0
fi

target_sha="${1:-}"
schema="${2:-}"
mode="${3:-}"
if ! [[ "$target_sha" =~ ^[0-9a-f]{40}$ ]] || ! [[ "$schema" =~ ^[a-z0-9_]{1,64}$ ]]; then
  echo 'MONITOR_TARGET_IDENTITY_INVALID' >&2
  exit 2
fi
repo_root="$(git rev-parse --show-toplevel)"
if [ "$(git rev-parse HEAD)" != "$target_sha" ] || [ -n "$(git status --porcelain)" ]; then
  echo 'MONITOR_SOURCE_NOT_FIXED_CLEAN_HEAD' >&2
  exit 2
fi
source_file="$repo_root/ops/host/w2-v3-readonly-monitor.py"
# The read-only monitor lives at a stable path: its source is versioned by the
# git SHA it was synced from (checked below), while the release SHA and schema
# head it must reconcile are read at run time from release.env's W2_GIT_SHA /
# W2_SCHEMA_HEAD (deploy intent), never hard-coded.
remote_dir="/opt/w2/deploy/v3-monitor"
deployed_sha="$(ssh w2-hk "grep -E '^W2_GIT_SHA=' /opt/w2/shared/release.env 2>/dev/null | cut -d= -f2")"
if ! git cat-file -e "$deployed_sha^{commit}" 2>/dev/null; then
  git fetch origin "$deployed_sha" >/dev/null 2>&1 || { echo "MONITOR_DEPLOYED_SHA_NOT_FOUND deployed=$deployed_sha" >&2; exit 2; }
fi
target_biz_tree="$(biz_tree_of "$target_sha")"
deployed_biz_tree="$(biz_tree_of "$deployed_sha")"
if [ "$target_biz_tree" != "$deployed_biz_tree" ]; then
  echo "MONITOR_BIZ_TREE_NOT_DEPLOYED target=$target_sha target_biz=$target_biz_tree deployed=$deployed_sha deployed_biz=$deployed_biz_tree" >&2
  exit 2
fi
if [ "$mode" = '--dry-run' ]; then
  echo "MONITOR_UPDATE_PLAN sha=$target_sha schema=$schema directory=$remote_dir"
  exit 0
fi
if [ -n "$mode" ]; then
  echo 'MONITOR_MODE_INVALID' >&2
  exit 2
fi
source_hash="$(shasum -a 256 "$source_file" | cut -d ' ' -f 1)"
temporary="$(mktemp -d)"
trap 'rm -rf "$temporary"' EXIT
cat > "$temporary/wrapper" <<EOF
#!/usr/bin/env bash
set -uo pipefail
report_root=/opt/w2/shared/runtime/reports/v3-monitor
# ── 报告轮转（指令书 D1，2026-10-10）────────────────────────────────────────
# 轮转前实测：该目录 1746 份 / 5.1G，零轮转、日增约 1.1G（单份从 1.17MB 膨胀到
# 23.7MB）——是当时的主要磁盘泄漏源（df 89%，约 3 天打满）。
# 策略：保留最近 48 份原文（≈1 天，足够比对「治理前/后」与近期诊断）+ latest.json；
#       48 份之前且 7 天以内 → gzip 归档；7 天以上 → 删除。
# 铁律：轮转任何失败都只 warn，**绝不阻断巡检主流程**（轮转失败本身也是哨兵关注点）。
rotate_reports() {
  local d="\$report_root"
  [ -d "\$d" ] || return 0
  # ① 删除 7 天以上（不含 latest* 符号链接；先删归档再删原文，避免半截）
  find "\$d" -maxdepth 1 -type f -name '*.json.gz' -mtime +7 -delete 2>/dev/null || true
  find "\$d" -maxdepth 1 -type f -mtime +7 \
       \( -name '[0-9]*.json' -o -name '[0-9]*.stdout' -o -name '[0-9]*.stderr' -o -name '[0-9]*.exitcode' \) \
       -delete 2>/dev/null || true
  # ② 48 份之前、7 天以内 → gzip（按 .json 的时间序定位同批次文件）
  local keep=48 idx=0 f base
  while IFS= read -r f; do
    idx=\$((idx + 1))
    [ "\$idx" -le "\$keep" ] && continue
    case "\$f" in *.gz) continue ;; esac
    base="\${f%.json}"
    for suffix in .json .stdout .stderr .exitcode; do
      [ -f "\$base\$suffix" ] && gzip -9 -f "\$base\$suffix" 2>/dev/null || true
    done
  done < <(ls -1t "\$d"/[0-9]*.json 2>/dev/null)
}
stamp="\$(date -u +%Y%m%dT%H%M%SZ)-\$\$"
report="\$report_root/\$stamp.json"
export W2_MONITOR_LOCAL=1
expected_sha="\$(grep -E '^W2_GIT_SHA=' /opt/w2/shared/release.env | cut -d= -f2)"
expected_schema="\$(grep -E '^W2_SCHEMA_HEAD=' /opt/w2/shared/release.env | cut -d= -f2)"
python3 '$remote_dir/monitor.py' "\$report" "\$expected_sha" "\$expected_schema" > "\$report_root/\$stamp.stdout" 2> "\$report_root/\$stamp.stderr"
result=\$?
printf '%s\n' "\$result" > "\$report_root/\$stamp.exitcode"
ln -sfn "\$stamp.exitcode" "\$report_root/latest.exitcode"
if [ -f "\$report" ]; then ln -sfn "\$stamp.json" "\$report_root/latest.json"; fi
# 轮转在所有产出落盘之后执行；失败只记录，不影响 result
rotate_reports || echo "REPORT_ROTATE_WARN failed (非阻断)" >&2
cat "\$report_root/\$stamp.stdout"
if [ "\$result" -ne 0 ]; then cat "\$report_root/\$stamp.stderr" >&2; fi
exit "\$result"
EOF
ssh w2-hk "mkdir -p '$remote_dir'"
scp "$source_file" "w2-hk:$remote_dir/monitor.py.incoming"
scp "$temporary/wrapper" "w2-hk:$remote_dir/wrapper.incoming"
ssh w2-hk "set -eu
echo '$source_hash  $remote_dir/monitor.py.incoming' | sha256sum -c -
if [ -f '$remote_dir/monitor.py' ] && echo '$source_hash  $remote_dir/monitor.py' | sha256sum -c - >/dev/null 2>&1; then
  # 已是目标版本 → 幂等丢弃 incoming
  rm '$remote_dir/monitor.py.incoming'
else
  # 不存在或旧版 → 用 incoming 覆盖（此前旧版走 sha256sum 失败退出，从未覆盖，导致脱节）
  mv '$remote_dir/monitor.py.incoming' '$remote_dir/monitor.py'
fi
python3 -m py_compile '$remote_dir/monitor.py'
bash -n '$remote_dir/wrapper.incoming'
install -m 755 '$remote_dir/wrapper.incoming' /usr/local/bin/w2-v3-readonly-monitor.next
mv /usr/local/bin/w2-v3-readonly-monitor.next /usr/local/bin/w2-v3-readonly-monitor
systemctl is-active w2-v3-readonly-monitor.timer"
echo "MONITOR_UPDATED sha=$target_sha schema=$schema source_sha256=$source_hash"
