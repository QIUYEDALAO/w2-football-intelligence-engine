#!/usr/bin/env bash
# w2-release — 把发布收敛成一条命令。
#
# 老K 发布时只敲一条命令，脚本完成：
#   前置检查 → 判断是否需要备份 → 构建 → 部署 → 回读 → 推送 → 备份轮转 → 回执骨架
# 任何一步不通过就停下并打印 FAIL，不继续、不推送、不轮转。
#
# 用法：
#   w2-release [--target <sha，默认 HEAD>] [--dry-run] [--skip-window-check]
#
# 本脚本在 Mac 本机运行；构建 python 镜像在 VPS、web 镜像在 Mac buildx，
# 部署与回读都通过 ssh 在 VPS 上执行。--dry-run 只打印计划不产生副作用。
#
# 可用环境变量（测试注入点，均可在 shell 中覆盖）：
#   W2_RELEASE_SSH_HOST         ssh 目标（默认 w2-hk）
#   W2_RELEASE_NOW             覆盖当前时间（ISO8601 UTC，如 2026-09-18T12:00:00Z）
#   W2_RELEASE_BLOCKED_WINDOW  手动指定禁止部署时段 HH:MM-HH:MM（默认空：改用评估档位窗口检查）
#   W2_RELEASE_STABILIZE_SEC   部署后稳定等待秒数（默认 180）
#   W2_RELEASE_BASE_TAG         runtime-base 标签（默认 4d5f257daa500878）
#   W2_RELEASE_GIT              git 命令（默认 git）
#   W2_RELEASE_SOURCE_RECOVERY_SHA256  显式恢复已封存的源码漂移；默认仍拒绝漂移
set -uo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# 常量
# ─────────────────────────────────────────────────────────────────────────────
BRANCH="${W2_RELEASE_BRANCH:-codex/w2-authority-20260916}"
REMOTE="${W2_RELEASE_REMOTE:-github-w2}"
SSH_HOST="${W2_RELEASE_SSH_HOST:-w2-hk}"
BLOCKED_WINDOW="${W2_RELEASE_BLOCKED_WINDOW:-}"
STABILIZE_SEC="${W2_RELEASE_STABILIZE_SEC:-60}"
GATE_MAX_WAIT_SEC="${W2_RELEASE_GATE_MAX_WAIT_SEC:-3600}"
GATE_POLL_SEC="${W2_RELEASE_GATE_POLL_SEC:-30}"
ACTIVE_CLAIM_MAX_WAIT_SEC="${W2_RELEASE_ACTIVE_CLAIM_MAX_WAIT_SEC:-1800}"
ACTIVE_CLAIM_POLL_SEC="${W2_RELEASE_ACTIVE_CLAIM_POLL_SEC:-5}"
DRAIN_MAX_WAIT_SEC="${W2_RELEASE_DRAIN_MAX_WAIT_SEC:-600}"
DRAIN_POLL_SEC="${W2_RELEASE_DRAIN_POLL_SEC:-30}"
BASE_TAG="${W2_RELEASE_BASE_TAG:-4d5f257daa500878}"
GIT_CMD="${W2_RELEASE_GIT:-git}"
SOURCE_RECOVERY_SHA256="${W2_RELEASE_SOURCE_RECOVERY_SHA256:-}"
if [ -n "$SOURCE_RECOVERY_SHA256" ] && ! [[ "$SOURCE_RECOVERY_SHA256" =~ ^[0-9a-f]{64}$ ]]; then
  echo "FAIL: RECOVERY_MANIFEST_DIGEST_INVALID" >&2
  exit 2
fi
NGINX_BASE="${W2_RELEASE_NGINX_BASE:-1.27.5-alpine}"

# VPS 侧固定路径（与现行部署布局一致）
VPS_DEPLOY_ROOT="/opt/w2"
VPS_COMPOSE_FILE="$VPS_DEPLOY_ROOT/deploy/compose.staging.yml"
VPS_OVERRIDE_FILE="$VPS_DEPLOY_ROOT/deploy/controlled-future-refresh.override.yml"
VPS_ENV_FILE="$VPS_DEPLOY_ROOT/shared/.env"
VPS_RELEASE_ENV="$VPS_DEPLOY_ROOT/shared/release.env"
VPS_REPORTS_DIR="$VPS_DEPLOY_ROOT/shared/runtime/reports"

# Mac 侧固定路径
BACKUP_ROTATE_SCRIPT="${HOME}/Documents/Projects/W2-workspaces/w2-authority-20260916/ops/host/w2-mac-backup-rotate"
RECEIPT_DIR="${HOME}/Desktop/W2文档"

API_PORT=18000
WEB_PORT=18080

# 评估档位（部署窗口冲突检查用）
CHECKPOINT_SLOTS="T3_ODDS T60_ODDS_LINEUPS T45_ODDS T-30m_VALIDATION_LOCK T15_ODDS"

# ─────────────────────────────────────────────────────────────────────────────
# 工具函数
# ─────────────────────────────────────────────────────────────────────────────
NOW_ISO=""
if [ -n "${W2_RELEASE_NOW:-}" ]; then
  NOW_ISO="$W2_RELEASE_NOW"
else
  NOW_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
fi

log()  { printf '%s\n' "$*"; }
warn() { printf 'FAIL: %s\n' "$*" >&2; }

# 可注入的外部命令（单元测试用 fake 覆盖）
SSH_CMD="${W2_RELEASE_SSH_CMD:-ssh}"
SCP_CMD="${W2_RELEASE_SCP_CMD:-scp}"
DOCKER_CMD="${W2_RELEASE_DOCKER_CMD:-docker}"

# 在 VPS 上执行一条命令
vps() {
  $SSH_CMD "$SSH_HOST" "$@"
}

# 容器切换后 /v1/version 可能短暂不可读；仅对空值或读取失败重试。
# 首次读到非空 release_id 即返回，由调用方核对目标 SHA。
read_release_id_with_retry() {
  local attempt response release_id
  for attempt in 1 2 3; do
    release_id=""
    if response="$(vps "curl -fsS --max-time 10 http://127.0.0.1:${API_PORT}/v1/version" 2>/dev/null)"; then
      release_id="$(printf '%s' "$response" | python3 -c 'import json,sys; value=json.load(sys.stdin).get("release_id"); print(value.strip() if isinstance(value,str) else "")' 2>/dev/null || true)"
    fi
    if [ -n "$release_id" ]; then
      printf '%s\n' "$release_id"
      return 0
    fi
    if [ "$attempt" -lt 3 ]; then
      sleep 3
    fi
  done
  return 1
}

# 拷贝文件到 VPS
scp_to_vps() {
  $SCP_CMD "$@"
}

# 脚本开始计时（秒）
START_EPOCH="$(date +%s)"

# ─────────────────────────────────────────────────────────────────────────────
# 纯函数（可单测）
# ─────────────────────────────────────────────────────────────────────────────

# now_iso(UTC) 是否落在禁止时段 window(HH:MM-HH:MM) 内。输出 0=在禁止时段内，1=否。
in_blocked_window() {
  local now_iso="$1" window="$2"
  local start end hhmm
  start="${window%%-*}"
  end="${window##*-}"
  # macOS date 与 GNU date 语法不同，两者都试
  if date -j -f "%Y-%m-%dT%H:%M:%SZ" "$now_iso" "+%H:%M" >/dev/null 2>&1; then
    hhmm="$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%SZ" "$now_iso" "+%H:%M")"
  else
    hhmm="$(TZ=UTC date -d "$now_iso" "+%H:%M" 2>/dev/null || echo "")"
  fi
  [ -z "$hhmm" ] && return 1
  # HH:MM 字典序比较：13:00 <= hhmm < 19:30 即在禁止时段内
  if [[ "$hhmm" > "$start" || "$hhmm" == "$start" ]] && [[ "$hhmm" < "$end" ]]; then
    return 0
  fi
  return 1
}

# 最近可用时间（禁止时段结束后）：window 的 end，格式化为 HH:MM UTC。
next_available_time() {
  local window="$1"
  printf '%s' "${window##*-}"
}

# ISO8601 UTC -> epoch 秒（macOS date 与 GNU date 都兼容）
iso_to_epoch() {
  local iso="$1"
  if date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$iso" "+%s" >/dev/null 2>&1; then
    date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$iso" "+%s" 2>/dev/null
  else
    date -d "$iso" "+%s" 2>/dev/null || echo ""
  fi
}

# epoch 秒 -> ISO8601 UTC
epoch_to_iso() {
  local epoch="$1"
  if date -u -r "$epoch" "+%Y-%m-%dT%H:%M:%SZ" >/dev/null 2>&1; then
    date -u -r "$epoch" "+%Y-%m-%dT%H:%M:%SZ" 2>/dev/null
  else
    date -u -d "@$epoch" "+%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo ""
  fi
}

# 判断评估档位是否与部署窗口冲突。
# 若任一档位 scheduled_at 落在 [now-5min, now+15min] 内则冲突。
# 输入：now_iso(UTC) 与空格分隔的档位 scheduled_at(ISO) 列表。
# 输出：无冲突 -> "0"；冲突 -> "1 <最近可部署时间 ISO>"（最晚档位 +15min）。
checkpoint_window_conflict() {
  local now_iso="$1" slot slot_epoch now_epoch lo_epoch hi_epoch latest=0
  shift
  now_epoch="$(iso_to_epoch "$now_iso")"
  [ -z "$now_epoch" ] && { echo "0"; return 0; }
  lo_epoch=$((now_epoch - 300))
  hi_epoch=$((now_epoch + 900))
  for slot in "$@"; do
    slot_epoch="$(iso_to_epoch "$slot")"
    [ -z "$slot_epoch" ] && continue
    if [ "$slot_epoch" -ge "$lo_epoch" ] && [ "$slot_epoch" -le "$hi_epoch" ]; then
      [ "$slot_epoch" -gt "$latest" ] && latest="$slot_epoch"
    fi
  done
  if [ "$latest" -gt 0 ]; then
    echo "1 $(epoch_to_iso $((latest + 900)))"
  else
    echo "0"
  fi
}

# 从 migrations/versions 目录解析 alembic head（不写死）。
# 输入：versions 目录路径；输出：head revision（多个用逗号连接）。
migration_heads_from_dir() {
  local versions_dir="$1"
  python3 - "$versions_dir" <<'PY'
import glob, os, re, sys
versions = sys.argv[1]
revs = {}
for f in glob.glob(versions + '/*.py'):
    text = open(f, encoding='utf-8').read()
    m = re.search(r'revision\b[^"\n]*"([^"]+)"', text)
    d = re.search(r'down_revision\b[^"\n]*"([^"]*)"', text)
    if m:
        revs[m.group(1)] = d.group(1) if d else None
down = {v for v in revs.values() if v}
heads = [r for r in revs if r not in down]
print(','.join(sorted(heads)))
PY
}

# 判断线上 release 与 target 之间是否需要备份：diff 中是否含 migrations/ 改动。
# 输出 "yes" 或 "no"。参数：base_sha target_sha
needs_backup() {
  local base="$1" target="$2" changed
  if [ "$base" = "$target" ]; then
    echo "no"
    return 0
  fi
  changed="$("$GIT_CMD" diff --name-only "$base" "$target" 2>/dev/null || true)"
  if printf '%s\n' "$changed" | grep -q '^migrations/'; then
    echo "yes"
  else
    echo "no"
  fi
}

# 被 source 时（单元测试），只暴露纯函数与常量，不执行主流程
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0 2>/dev/null || exit 0
fi

# ─────────────────────────────────────────────────────────────────────────────
# 参数解析
# ─────────────────────────────────────────────────────────────────────────────
TARGET=""
DRY_RUN=0
SKIP_WINDOW=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target) TARGET="${2:-}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --skip-window-check) SKIP_WINDOW=1; shift ;;
    -h|--help)
      cat <<'USAGE'
用法: w2-release [--target <sha，默认 HEAD>] [--dry-run] [--skip-window-check]

  前置检查 → 判断是否需要备份 → 构建 → 部署 → 回读 → 推送 → 备份轮转 → 回执骨架
  任何一步不通过就停下并打印 FAIL，不继续、不推送、不轮转。

  --target <sha>         要发布的提交，默认 HEAD
  --dry-run              只打印计划，不执行构建/部署/推送/轮转
  --skip-window-check    跳过部署窗口检查（评估档位前后 / 手动时段）
USAGE
      exit 0 ;;
    *)
      echo "unknown argument: $1" >&2
      echo "用法: w2-release [--target <sha>] [--dry-run] [--skip-window-check]" >&2
      exit 2 ;;
  esac
done

# 目标提交：默认 HEAD；短 SHA 解析成完整 40 位 SHA。否则 8 位短 SHA 会被写进
# W2_GIT_SHA，触发 scheduler 健康检查的 SOURCE_REVISION_NOT_BOUND_TO_EXACT_GIT_SHA。
if [ -z "$TARGET" ]; then
  TARGET="$("$GIT_CMD" rev-parse HEAD 2>/dev/null || echo "")"
elif ! printf '%s' "$TARGET" | grep -Eq '^[0-9a-f]{40}$'; then
  TARGET="$("$GIT_CMD" rev-parse "$TARGET" 2>/dev/null || echo "")"
fi
if [ -z "$TARGET" ]; then
  warn "无法解析目标提交（git rev-parse 失败）"
  exit 2
fi

log "== w2-release 开始 =="
log "now=$NOW_ISO target=$TARGET dry_run=$DRY_RUN skip_window=$SKIP_WINDOW"

# ─────────────────────────────────────────────────────────────────────────────
# 步骤 1：前置检查
# ─────────────────────────────────────────────────────────────────────────────
log ""
log "== 1. 前置检查 =="

# 1a. 唯一工作区干净
if [ -n "$("$GIT_CMD" status --porcelain=v1 2>/dev/null)" ]; then
  warn "工作区不干净：存在未提交改动"
  "$GIT_CMD" status --porcelain=v1 2>/dev/null | head -20
  exit 2
fi
log "工作区干净"

# 1b. 分支正确
current_branch="$("$GIT_CMD" branch --show-current 2>/dev/null || echo "")"
if [ "$current_branch" != "$BRANCH" ]; then
  warn "分支不正确：当前=$current_branch 期望=$BRANCH"
  exit 2
fi
log "分支正确：$current_branch"

# 1c. --target 已提交
if ! "$GIT_CMD" cat-file -e "$TARGET^{commit}" 2>/dev/null; then
  warn "目标提交不存在：$TARGET"
  exit 2
fi
log "目标提交存在：$TARGET"

# 1d. 当前线上 release 可读
online_release=""
SAFE_PAUSE_RESUME=0
if vps "curl -fsS --max-time 10 http://127.0.0.1:${API_PORT}/v1/version" > /tmp/w2-release-version.json 2>/dev/null; then
  online_release="$(python3 -c 'import json,sys; print(json.load(open("/tmp/w2-release-version.json")).get("release_id",""))' 2>/dev/null || echo "")"
fi
if [ -z "$online_release" ]; then
  # A previous failed release deliberately stopped API/Web. Resume directly
  # from verified paused candidate collectors; never restart an old public API
  # just to obtain /v1/version, or trust the stale release.env as live identity.
  if ! pause_proof="$("$GIT_CMD" show "${TARGET}:scripts/w2_safe_pause_identity.py" | \
      $SSH_CMD "$SSH_HOST" 'python3 -')"; then
    warn "当前线上 release 不可读，且无法证明安全暂停身份"
    exit 2
  fi
  online_release="$(printf '%s' "$pause_proof" | python3 -c \
    'import json,sys; print(json.load(sys.stdin)["release_id"])' 2>/dev/null || true)"
  if ! [[ "$online_release" =~ ^[0-9a-f]{40}$ ]]; then
    warn "SAFE_PAUSE_RELEASE_IDENTITY_INVALID"
    exit 2
  fi
  SAFE_PAUSE_RESUME=1
  log "SAFE_PAUSE_RESUME_IDENTITY $pause_proof"
fi
log "当前线上 release：$online_release"

# 1e. 禁止时段判断
if [ "$SKIP_WINDOW" = "0" ]; then
  if [ -n "$BLOCKED_WINDOW" ]; then
    # 手动指定固定时段（W2_RELEASE_BLOCKED_WINDOW）
    if in_blocked_window "$NOW_ISO" "$BLOCKED_WINDOW"; then
      warn "处于禁止部署时段（UTC ${BLOCKED_WINDOW}）内"
      warn "最近可用时间：UTC $(next_available_time "$BLOCKED_WINDOW")"
      warn "可用 --skip-window-check 显式跳过（仅限紧急且经 Owner 批准）"
      exit 2
    fi
    log "固定时段检查通过（当前不在 ${BLOCKED_WINDOW} 内）"
  else
    # 默认：评估档位窗口检查（未来 15 分钟 / 过去 5 分钟内有档位则拒绝）
    # fail-closed：查询失败即拒绝部署，绝不把「查不到」当成「无冲突」
    if ! slot_rows="$(vps "docker exec w2-staging-postgres-1 psql -XAt -U w2_user -d w2 -c \"SELECT replace(to_char(scheduled_at AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS'), ' ', 'T') || 'Z' FROM matchday_checkpoint_plans WHERE checkpoint IN ('T3_ODDS','T60_ODDS_LINEUPS','T45_ODDS','T-30m_VALIDATION_LOCK','T15_ODDS') AND scheduled_at >= now() - interval '5 minutes' AND scheduled_at <= now() + interval '15 minutes' ORDER BY scheduled_at;\"" 2>/dev/null)"; then
      warn "评估档位窗口查询失败，无法确认是否临近档位，拒绝部署（fail-closed）"
      warn "可用 --skip-window-check 显式跳过（仅限紧急且经 Owner 批准）"
      exit 2
    fi
    conflict_result="$(checkpoint_window_conflict "$NOW_ISO" $slot_rows)"
    conflict_flag="${conflict_result%% *}"
    if [ "$conflict_flag" = "1" ]; then
      available="${conflict_result#* }"
      warn "未来 15 分钟或过去 5 分钟内有评估档位（${CHECKPOINT_SLOTS}），拒绝部署"
      warn "最近可部署时间：${available}"
      warn "可用 --skip-window-check 显式跳过（仅限紧急且经 Owner 批准）"
      exit 2
    fi
    log "评估档位窗口检查通过（无临近档位）"
  fi
else
  log "时段检查已跳过（--skip-window-check）"
fi

# 1f. 目标与线上是否相同
ALREADY_LATEST=0
if [ "$TARGET" = "$online_release" ] && [ "$SAFE_PAUSE_RESUME" = 0 ]; then
  ALREADY_LATEST=1
  log "目标提交 == 线上 release（已是最新，无需发布）"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 步骤 2：判断是否需要备份
# ─────────────────────────────────────────────────────────────────────────────
log ""
log "== 2. 是否需要备份 =="
need_backup="$(needs_backup "$online_release" "$TARGET")"
changed_files="$("$GIT_CMD" diff --name-only "$online_release" "$TARGET" 2>/dev/null || true)"
changed_stat="$("$GIT_CMD" diff --stat "$online_release" "$TARGET" 2>/dev/null || true)"
log "改动文件："
printf '%s\n' "$changed_files" | sed 's/^/  /' | head -50
if [ "$need_backup" = "yes" ]; then
  log "检测到 migrations 目录改动 → 需要备份"
else
  log "无 migrations 目录改动 → 跳过备份（无迁移，跳过）"
fi

# 动态取目标 schema head（不写死）
head_tmp="$(mktemp -d)"
"$GIT_CMD" archive "$TARGET" migrations/versions 2>/dev/null | tar -xf - -C "$head_tmp" 2>/dev/null || true
target_head="$(migration_heads_from_dir "$head_tmp/migrations/versions" 2>/dev/null || echo "")"
rm -rf "$head_tmp"
if [ -z "$target_head" ]; then
  warn "无法从目标提交解析 alembic head"
  exit 2
fi
log "目标 schema head：$target_head"

# 写回执（成功/失败共用）。result=成功|失败，detail=失败原因（成功时为空）。
write_receipt() {
  local result="$1" detail="${2:-}"
  local first_line
  END_EPOCH="$(date +%s)"
  ELAPSED="$((END_EPOCH - START_EPOCH))"
  RECEIPT_DATE="$(date -u +%Y%m%d)"
  RECEIPT_FILE="${RECEIPT_DIR}/W2_发布_${TARGET}_${RECEIPT_DATE}.md"
  if [ "$result" = "成功" ]; then
    first_line="结果：成功"
  else
    first_line="结果：失败（${detail}）"
  fi
  {
    echo "# W2 发布回执 ${TARGET}（${RECEIPT_DATE}）"
    echo ""
    echo "${first_line}"
    echo ""
    echo "## 前后 release"
    echo ""
    echo "- 前：\`${online_release}\`"
    echo "- 后：\`${TARGET}\`"
    echo ""
    echo "## 改动文件 stat"
    echo ""
    echo '```'
    printf '%s\n' "$changed_stat"
    echo '```'
    echo ""
    echo "## 是否备份"
    echo ""
    if [ "$need_backup" = "yes" ]; then
      echo "- 是（migrations 改动）：\`${backup_file:-未生成}\`"
    else
      echo "- 否（无迁移，跳过）"
    fi
    echo ""
    echo "## 回读每一项的原始输出"
    echo ""
    echo '```'
    if [ -n "${LOCAL_LOG:-}" ] && [ -f "$LOCAL_LOG" ]; then
      grep -E '^READBACK |^WARNING |^SWITCH_OK|^DEPLOY_COMPLETE|^MIGRATION_OK|^READBACK_FAILED|^READBACK_FAILED_KEPT_NEW|^MANUAL_DECISION_REQUIRED|^ROLLBACK_' "$LOCAL_LOG" 2>/dev/null || true
    else
      echo "（无 VPS 输出）"
    fi
    echo '```'
    echo ""
    echo "## 推送结果"
    echo ""
    echo '```'
    if [ -n "${remote_sha:-}" ]; then
      echo "远端 sha：${remote_sha}"
    else
      echo "未推送"
    fi
    echo '```'
    echo ""
    echo "## 耗时"
    echo ""
    echo "- ${ELAPSED}s"
    echo ""
    echo "## 执行方说明"
    echo ""
    echo "（待老K 填写）"
    echo ""
    echo "## 异常与处置"
    echo ""
    echo "（待老K 填写）"
  } > "$RECEIPT_FILE"
  log "回执：$RECEIPT_FILE"
}

# 部署/回读/推送任一环节失败：写失败回执并退出（退出码非 0，不推送、不轮转）
fail_release() {
  local reason="$1"
  warn "$reason"
  write_receipt "失败" "$reason"
  exit 1
}

# dry-run：打印完整计划后结束
if [ "$DRY_RUN" = "1" ]; then
  log ""
  log "== dry-run 计划（不执行，无副作用） =="
  log "  1. 前置检查：通过（工作区干净 / 分支 ${BRANCH} / target=${TARGET} / 线上=${online_release}）"
  if [ "$ALREADY_LATEST" = "1" ]; then
    log "     → target == 线上 release，无操作"
    log "  2. 备份：无改动，跳过（无迁移，跳过）"
    log "  3. 构建：跳过（无新 revision）"
    log "  4. 部署：跳过（无新 revision）"
    log "  5. 回读：跳过（无部署）"
    log "  6. 推送：跳过（无新提交）"
    log "  7. 备份轮转：跳过（未备份）"
    log "  8. 回执骨架：不生成（无发布）"
  else
    log "  2. 备份：$([ "$need_backup" = "yes" ] && echo "pg_dump -Fc → ${HOME}/Desktop/W2文档/backups" || echo "无迁移，跳过")"
    log "  2b. schema head：${target_head}（从目标 migrations 动态解析，不写死）"
    log "  3. 构建：python 镜像（VPS, Dockerfile.release, base=${BASE_TAG}）+ web 镜像（Mac buildx amd64, nginx=${NGINX_BASE}），均打 revision=${TARGET}，推本地 registry"
    if [ "$need_backup" = "yes" ]; then
      log "  3b. 迁移：新镜像 alembic upgrade head → 校验 schema == ${target_head}（失败则停止且不切换）"
    fi
    log "  4. 部署：同步并校验 controlled-future-refresh.override.yml，再切换 release.env（8 个 key）"
    log "  5. 回读 8 项：a 六接口200 / b release_id+sha 一致 / c 推荐>0且倒序 / d market_radar 抽样3场≥1 / e 最长180秒轮询全容器healthy后校验StartedAt及结果配额=800 / f 部署后${STABILIZE_SEC}s Traceback=0 / g outbox 无过期样本 / h 最长${DRAIN_MAX_WAIT_SEC}s确认逾期DUE排空在推进（N1<N0，或N0=0）"
    log "  6. 推送：git push $REMOTE $BRANCH 并回读远端 sha 一致"
    log "  7. 备份轮转：$([ "$need_backup" = "yes" ] && echo "w2-mac-backup-rotate" || echo "本次未备份，跳过")"
    log "  8. 回执骨架：$RECEIPT_DIR/W2_发布_${TARGET}_$(date -u +%Y%m%d).md"
  fi
  log ""
  log "== dry-run 结束 =="
  exit 0
fi

# 实际模式：目标已是最新 → 无需发布
if [ "$ALREADY_LATEST" = "1" ]; then
  log "目标已是最新，无需发布。"
  exit 0
fi

# ─────────────────────────────────────────────────────────────────────────────
# 步骤 2（实际）：备份
# ─────────────────────────────────────────────────────────────────────────────
BACKUP_DONE=0
if [ "$need_backup" = "yes" ]; then
  log "执行 pg_dump -Fc 备份（VPS 本地，不回传 Mac）..."
  backup_stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup_file="/opt/w2/backups/predeploy-${TARGET}-${backup_stamp}.dump"
  # 备份只写 VPS 本地：大库（~1.5GB）经 SSH 回传 Mac 会拖慢发布数十分钟，
  # 且备份仅用于回滚兜底，放 VPS 本地更可靠。
  if vps "mkdir -p /opt/w2/backups && docker exec w2-staging-postgres-1 pg_dump -U w2_user -d w2 -Fc > ${backup_file}"; then
    backup_size="$(vps "stat -c %s ${backup_file}" 2>/dev/null | tr -d '[:space:]' || echo 0)"
    # 备份文件在宿主机，pg_restore 在容器内看不到该路径，须经 stdin 传入校验。
    if [ -n "$backup_size" ] && [ "$backup_size" -gt 0 ] \
       && vps "docker exec -i w2-staging-postgres-1 pg_restore --list < ${backup_file}" >/dev/null 2>&1; then
      log "备份完成：${backup_file}（${backup_size} bytes，pg_restore --list 校验通过）"
      BACKUP_DONE=1
      # VPS 上 predeploy-*.dump 只保留最新 3 份
      vps "ls -1t /opt/w2/backups/predeploy-*.dump 2>/dev/null | tail -n +4 | xargs -r rm -f" || true
    else
      warn "pg_dump 备份校验失败（空文件或不可读）：${backup_file}"
      exit 2
    fi
  else
    warn "pg_dump 备份失败"
    exit 2
  fi
else
  log "无迁移，跳过备份"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 步骤 3：构建
# ─────────────────────────────────────────────────────────────────────────────
log ""
log "== 3. 构建 =="
BUILD_TIME="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# 3a. python 镜像（VPS）
log "构建 python 镜像（VPS）..."
git_archive="w2-src-${TARGET}.tar"
"$GIT_CMD" archive "$TARGET" > "/tmp/${git_archive}" || { warn "git archive 失败"; exit 2; }
scp_to_vps "/tmp/${git_archive}" "$SSH_HOST:/tmp/${git_archive}" >/dev/null || { warn "scp 源码到 VPS 失败"; exit 2; }
build_dir="${VPS_DEPLOY_ROOT}/builds/${TARGET}-$(date -u +%Y%m%dT%H%M%SZ)-$$"
vps "test ! -e ${build_dir} && sudo mkdir -p ${build_dir} && sudo tar -xf /tmp/${git_archive} -C ${build_dir}" \
  || { warn "VPS 解压源码失败"; exit 2; }
vps "cd ${build_dir} && docker build -f Dockerfile.release --build-arg BASE_IMAGE=127.0.0.1:5000/w2/runtime-base:${BASE_TAG} --build-arg W2_GIT_SHA=${TARGET} --build-arg W2_BUILD_TIME=${BUILD_TIME} -t 127.0.0.1:5000/w2/python:${TARGET} . && docker run --rm --entrypoint alembic 127.0.0.1:5000/w2/python:${TARGET} heads | grep -Fqx '${target_head} (head)' && docker push 127.0.0.1:5000/w2/python:${TARGET}" \
  || { warn "python 镜像构建/推送失败"; exit 2; }
python_digest="$(vps "docker image inspect 127.0.0.1:5000/w2/python:${TARGET} --format '{{index .RepoDigests 0}}' 2>/dev/null" | sed 's|^.*@||')"
[ -n "$python_digest" ] || { warn "无法获取 python 镜像 digest"; exit 2; }
log "python digest：$python_digest"

# 3b. web 镜像（Mac buildx amd64）
log "构建 web 镜像（Mac buildx amd64）..."
$DOCKER_CMD buildx build --platform linux/amd64 -f Dockerfile.web \
  --build-context "nginxinc/nginx-unprivileged:1.27-alpine=docker-image://nginxinc/nginx-unprivileged:${NGINX_BASE}" \
  --build-arg VITE_GIT_SHA="${TARGET}" --build-arg VITE_BUILD_TIME="${BUILD_TIME}" --build-arg W2_RELEASE_ID="${TARGET}" \
  -t "127.0.0.1:5000/w2/web:${TARGET}" --load --progress=plain . \
  || { warn "web 镜像构建失败"; exit 2; }
web_tar="w2-web-${TARGET}.tar.gz"
$DOCKER_CMD save "127.0.0.1:5000/w2/web:${TARGET}" | gzip > "/tmp/${web_tar}" || { warn "docker save web 失败"; exit 2; }
scp_to_vps "/tmp/${web_tar}" "$SSH_HOST:/tmp/${web_tar}" >/dev/null || { warn "scp web 镜像到 VPS 失败"; exit 2; }
vps "docker load < /tmp/${web_tar} && docker push 127.0.0.1:5000/w2/web:${TARGET}" \
  || { warn "web 镜像 load/push 失败"; exit 2; }
web_digest="$(vps "docker image inspect 127.0.0.1:5000/w2/web:${TARGET} --format '{{index .RepoDigests 0}}' 2>/dev/null" | sed 's|^.*@||')"
[ -n "$web_digest" ] || { warn "无法获取 web 镜像 digest"; exit 2; }
log "web digest：$web_digest"

py_ref="127.0.0.1:5000/w2/python@${python_digest}"
web_ref="127.0.0.1:5000/w2/web@${web_digest}"

# 从目标提交提取受版本控制的 override，而不是信任工作区文件；部署会先把它
# 同步到 VPS 并回读两端 SHA-256 一致，再允许 compose 切换。
override_local_tmp="$(mktemp)"
if ! "$GIT_CMD" show "${TARGET}:infra/compose/controlled-future-refresh.override.yml" > "$override_local_tmp"; then
  rm -f "$override_local_tmp"
  warn "无法从目标提交读取 controlled-future-refresh.override.yml"
  exit 2
fi
override_repo_sha="$(shasum -a 256 "$override_local_tmp" | awk '{print $1}')"
[ -n "$override_repo_sha" ] || { rm -f "$override_local_tmp"; warn "无法计算仓库 override SHA-256"; exit 2; }
override_remote_candidate="/tmp/w2-controlled-future-refresh-${TARGET}.override.yml"
scp_to_vps "$override_local_tmp" "$SSH_HOST:${override_remote_candidate}" >/dev/null \
  || { rm -f "$override_local_tmp"; warn "scp controlled-future-refresh override 到 VPS 失败"; exit 2; }
rm -f "$override_local_tmp"
log "仓库 override sha256：$override_repo_sha"
pause_identity_path=""; pause_identity_sha=""
if [ "$SAFE_PAUSE_RESUME" = 1 ]; then
  pause_identity_local="$(mktemp)"
  "$GIT_CMD" show "${TARGET}:scripts/w2_safe_pause_identity.py" > "$pause_identity_local" || exit 2
  pause_identity_sha="$(shasum -a 256 "$pause_identity_local" | awk '{print $1}')"
  pause_identity_path="/tmp/w2-safe-pause-${TARGET}.py"
  scp_to_vps "$pause_identity_local" "$SSH_HOST:$pause_identity_path" >/dev/null || exit 2
  rm -f "$pause_identity_local"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 步骤 4+5：部署 + 回读（在 VPS 上一个会话内完成，输出回读结果）
# ─────────────────────────────────────────────────────────────────────────────
log ""
log "== 4. 部署 + 5. 回读（VPS）=="
UTC_STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
LOCAL_LOG="/tmp/w2-release-${UTC_STAMP}.log"
REMOTE_LOG="${VPS_REPORTS_DIR}/release-${UTC_STAMP}.log"

vps "sudo bash -s -- '${TARGET}' '${py_ref}' '${web_ref}' '${python_digest}' '${web_digest}' '${BUILD_TIME}' '${STABILIZE_SEC}' '${API_PORT}' '${WEB_PORT}' '${BASE_TAG}' '${need_backup}' '${online_release}' '${target_head}' '${SKIP_WINDOW}' '${GATE_MAX_WAIT_SEC}' '${GATE_POLL_SEC}' '${override_remote_candidate}' '${override_repo_sha}' '${DRAIN_MAX_WAIT_SEC}' '${DRAIN_POLL_SEC}' '${ACTIVE_CLAIM_MAX_WAIT_SEC}' '${ACTIVE_CLAIM_POLL_SEC}' '${SOURCE_RECOVERY_SHA256}' '${SAFE_PAUSE_RESUME}' '${pause_identity_path}' '${pause_identity_sha}'" <<'VPS_SCRIPT' 2>&1 | tee "$LOCAL_LOG"
set -euo pipefail
# 注意：heredoc 通过 `bash -s` 逐行读入 stdin，任何从 stdin 读取的子进程都会
# 吞掉后续脚本（导致提前结束、误报成功）。因此这里绝不能 `exec 0</dev/null`，
# 且 Q() 必须用 `docker exec`（不带 -i），否则会重读 heredoc 剩余内容。

release_sha="$1"; py_ref="$2"; web_ref="$3"; python_digest="$4"; web_digest="$5"
build_time="$6"; stabilize_sec="$7"; api_port="$8"; web_port="$9"; base_tag="${10}"
has_migration="${11}"; online_release="${12}"; target_head="${13}"; skip_window="${14}"
gate_max_wait_sec="${15}"; gate_poll_sec="${16}"
override_candidate="${17}"; override_repo_sha="${18}"
drain_max_wait_sec="${19}"; drain_poll_sec="${20}"
active_claim_max_wait_sec="${21}"; active_claim_poll_sec="${22}"
source_recovery_sha256="${23:-}"
safe_pause_resume="${24:-0}"
pause_identity_path="${25:-}"; pause_identity_sha="${26:-}"

compose=(docker compose -p w2-staging -f /opt/w2/deploy/compose.staging.yml -f /opt/w2/deploy/controlled-future-refresh.override.yml --env-file /opt/w2/shared/.env --env-file /opt/w2/shared/release.env)
Q() { docker exec w2-staging-postgres-1 psql -XAt -U w2_user -d w2 -c "$1"; }

echo "target_head=$target_head"
[ -n "$target_head" ] || { echo "FAIL 目标 head 为空"; exit 2; }

# 回滚状态：activate release.env 前 ACTIVE=0，切换后 ACTIVE=1。
# 用 EXIT trap（而非 ERR trap）保证 exit/||/set -e 任何退出路径都触发回滚。
ACTIVE=0
backup=""
OVERRIDE_SYNCED=0
override_backup=""
MIGRATION_DONE=0
pre_schema=""
ROLLBACK_NEEDED=1
OLD_STOPPED=0

rollback() {
  [ "$ROLLBACK_NEEDED" = "1" ] || return 0
  # Never restart a pre-v3 worker or public API after the cutover begins.
  # The old image can still write and expose AH/OU recommendations. A failed
  # migration/start/readback therefore pauses recommendations for manual repair.
  if [ "$OLD_STOPPED" = "1" ]; then
    echo "SAFE_PAUSE_START old_recommendation_reactivation=FORBIDDEN"
    "${compose[@]}" stop -t 60 scheduler worker worker-heavy api web || true
    for c in scheduler worker worker-heavy api web; do
      running="$(docker inspect "w2-staging-${c}-1" --format '{{.State.Running}}' 2>/dev/null || echo unknown)"
      echo "SAFE_PAUSE_SERVICE ${c} running=${running}"
    done
    current_schema="$(Q "SELECT version_num FROM alembic_version" 2>/dev/null || echo unknown)"
    echo "SAFE_PAUSE_SCHEMA pre=${pre_schema:-unknown} current=${current_schema} target=${target_head}"
    if ! docker run --rm --entrypoint python "$py_ref" -c '
import sys
from alembic.config import Config
from alembic.script import ScriptDirectory
script = ScriptDirectory.from_config(Config("/app/alembic.ini"))
current, target = sys.argv[1:]
assert script.get_current_head() == target
supported = {row.revision for row in script.walk_revisions(
    base="0076_forward_review_evidence", head=target)}
assert current in supported, "RECOVERY_SCHEMA_UNSUPPORTED"
' "$current_schema" "$target_head"; then
      echo "SAFE_PAUSE_COLLECTION_RECOVERY_FAILED:SCHEMA_UNSUPPORTED" >&2
      return 0
    fi
    # Restart only the candidate collectors. The separate override closes all
    # current write/public/send outlets but leaves raw capture and FT processing
    # available. Never restore release.pre-* or start the old API/Web image.
    recovery_override="/opt/w2/deploy/current-recommendations-paused.override.yml"
    printf 'services:\n' > "$recovery_override"
    for c in worker worker-heavy scheduler; do
      printf '  %s:\n    environment:\n      W2_CURRENT_RECOMMENDATIONS_PAUSED: "true"\n' "$c" >> "$recovery_override"
      if [ "$current_schema" != "$target_head" ]; then
        # Partial schema: disable the two stages that require the complete PG
        # fence. Queued independent XG still fails its head check before IO.
        printf '      W2_H2H_AUTO_CAPTURE_ENABLED: "false"\n      W2_XG_AUTO_CAPTURE_ENABLED: "false"\n' >> "$recovery_override"
      fi
    done
    recovery_compose=("${compose[@]}" -f "$recovery_override" --env-file "$candidate")
    if "${recovery_compose[@]}" up -d --no-deps --force-recreate worker worker-heavy scheduler; then
      recovery_valid=1
      for c in worker worker-heavy scheduler; do
        running="$(docker inspect "w2-staging-${c}-1" --format '{{.State.Running}}' 2>/dev/null || echo unknown)"
        image="$(docker inspect "w2-staging-${c}-1" --format '{{.Config.Image}}' 2>/dev/null || echo unknown)"
        paused="$(docker inspect "w2-staging-${c}-1" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | grep -Fx 'W2_CURRENT_RECOMMENDATIONS_PAUSED=true' || true)"
        echo "SAFE_PAUSE_COLLECTOR ${c} running=${running} image=${image} paused=${paused}"
        if [ "$running" != true ] || [ "$image" != "$py_ref" ] || [ -z "$paused" ]; then
          recovery_valid=0
        fi
      done
      if [ "$recovery_valid" != 1 ]; then
        "${recovery_compose[@]}" stop -t 60 worker worker-heavy scheduler || true
        echo "SAFE_PAUSE_COLLECTION_RECOVERY_FAILED" >&2
      else
        echo "SAFE_PAUSE_COLLECTION_RESTORED candidate=${release_sha}"
      fi
    else
      echo "SAFE_PAUSE_COLLECTION_RECOVERY_FAILED" >&2
    fi
    echo "SAFE_PAUSE_REQUIRES_MANUAL_RECOVERY old_release_env_not_reactivated=1"
    return 0
  fi
  if [ "$OVERRIDE_SYNCED" = "1" ] && [ -n "$override_backup" ]; then
    install -m 0644 "$override_backup" /opt/w2/deploy/controlled-future-refresh.override.yml || true
  fi
}

trap rollback EXIT

fail() {
  local msg="$1"
  echo "FAIL: $msg" >&2
  exit 2
}

echo "== sync controlled future refresh override =="
[ -f "$override_candidate" ] || fail "VPS override candidate 不存在：$override_candidate"
[ -f /opt/w2/deploy/controlled-future-refresh.override.yml ] || fail "VPS 当前 override 不存在"
override_before_sha="$(sha256sum /opt/w2/deploy/controlled-future-refresh.override.yml | awk '{print $1}')"
override_candidate_sha="$(sha256sum "$override_candidate" | awk '{print $1}')"
[ "$override_candidate_sha" = "$override_repo_sha" ] || \
  fail "override 上传后 SHA-256 不一致：candidate=$override_candidate_sha repo=$override_repo_sha"
override_backup="/opt/w2/deploy/controlled-future-refresh.pre-$(date -u +%Y%m%dT%H%M%SZ).override.yml"
cp /opt/w2/deploy/controlled-future-refresh.override.yml "$override_backup"
install -m 0644 "$override_candidate" /opt/w2/deploy/controlled-future-refresh.override.yml
OVERRIDE_SYNCED=1
override_after_sha="$(sha256sum /opt/w2/deploy/controlled-future-refresh.override.yml | awk '{print $1}')"
[ "$override_after_sha" = "$override_repo_sha" ] || \
  fail "VPS override 安装后 SHA-256 不一致：after=$override_after_sha repo=$override_repo_sha"
echo "OVERRIDE_SYNC before_sha=$override_before_sha repo_sha=$override_repo_sha after_sha=$override_after_sha"

echo "== preflight =="
W2_BASE_TAG="$base_tag" /usr/local/bin/w2-release-preflight "$py_ref" || fail "preflight"
W2_BASE_TAG="$base_tag" /opt/w2/deploy/w2-release-sync-preflight "$py_ref" "$web_ref" "$release_sha" || fail "release-sync-preflight"

# A running container may have writable-layer code that differs from its
# immutable image. /ready=503 with DB 0076 and in-container head 0084 was one
# such case. Do not treat an environment SHA label as source verification.
echo "== running image/source integrity =="
if [ "$safe_pause_resume" = 1 ]; then
  [ -f "$pause_identity_path" ] || fail "SAFE_PAUSE_IDENTITY_SCRIPT_MISSING"
  [ "$(sha256sum "$pause_identity_path" | awk '{print $1}')" = "$pause_identity_sha" ] || \
    fail "SAFE_PAUSE_IDENTITY_SCRIPT_CONFLICT"
  resume_proof="$(python3 "$pause_identity_path")" || fail "SAFE_PAUSE_IDENTITY_RECHECK_FAILED"
  resume_release="$(printf '%s' "$resume_proof" | python3 -c 'import json,sys; print(json.load(sys.stdin)["release_id"])')"
  [ "$resume_release" = "$online_release" ] || fail "SAFE_PAUSE_RELEASE_CHANGED"
  echo "SAFE_PAUSE_IDENTITY_RECHECK $resume_proof"
fi
# Alembic heads only cover migrations/versions. A non-migration source file
# modified in a container's writable layer (routers.py, repository.py, ...)
# keeps the head identical while changing behaviour, so also fingerprint the
# full Python source tree in the immutable image and the running container.
_src_fingerprint='import hashlib,pathlib
base=pathlib.Path("/app")
files=sorted(p for p in base.rglob("*.py") if "__pycache__" not in p.parts and p.is_file())
h=hashlib.sha256()
for p in files:
    h.update(p.relative_to(base).as_posix().encode()); h.update(b"\0"); h.update(p.read_bytes()); h.update(b"\0")
print(h.hexdigest())'
for old_service in api worker worker-heavy scheduler; do
  if [ "$safe_pause_resume" = 1 ] && [ "$old_service" = api ]; then
    # The rechecked identity requires API/Web OFF. Their stopped writable
    # layers are not live authorities and will be replaced, never restarted.
    echo "SAFE_PAUSE_PUBLIC_SOURCE_OFF:${old_service}"
    continue
  fi
  old_image="$(docker inspect "w2-staging-${old_service}-1" --format '{{.Image}}' 2>/dev/null || true)"
  [ -n "$old_image" ] || fail "PREEXISTING_IMAGE_UNKNOWN:${old_service}"
  image_head="$(docker run --rm --entrypoint alembic "$old_image" heads 2>/dev/null | awk '{print $1}' | head -1)"
  container_head="$(docker exec "w2-staging-${old_service}-1" alembic heads 2>/dev/null | awk '{print $1}' | head -1)"
  image_src="$(docker run --rm --entrypoint python "$old_image" -c "$_src_fingerprint" 2>/dev/null)"
  container_src="$(docker exec "w2-staging-${old_service}-1" python -c "$_src_fingerprint" 2>/dev/null)"
  echo "PREEXISTING_SOURCE_HEAD service=${old_service} image=${image_head:-unknown} container=${container_head:-unknown}"
  echo "PREEXISTING_SOURCE_HASH service=${old_service} image=${image_src:-unknown} container=${container_src:-unknown}"
  if [ -z "$image_head" ] || [ "$image_head" != "$container_head" ] || \
     [ -z "$image_src" ] || [ -z "$container_src" ] || [ "$image_src" != "$container_src" ]; then
    [ -n "$source_recovery_sha256" ] || fail "PREEXISTING_RUNTIME_SOURCE_DRIFT:${old_service}"
    # A recovery admits only a SHA-bound snapshot of this exact runtime source.
    # It never adopts that source: the trusted candidate still replaces every
    # old process after the drain gate and before any migration or public ON.
    docker run --rm --user 0 \
      --mount type=bind,src=/opt/w2/shared/runtime/reports,dst=/evidence,readonly \
      --entrypoint python "$py_ref" /app/scripts/w2_runtime_source_recovery.py verify \
      --manifest "/evidence/source-drift-recovery-${release_sha}.json" \
      --sha256 "$source_recovery_sha256" --target "$release_sha" --service "$old_service" \
      --database-revision "$(Q 'SELECT version_num FROM alembic_version')" \
      "$old_image" "$image_head" "$container_head" "$image_src" "$container_src" || \
      fail "PREEXISTING_RUNTIME_SOURCE_RECOVERY_INVALID:${old_service}"
  fi
done

echo "== release.env backup + candidate =="
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup="/opt/w2/shared/release.pre-${stamp}.env"
candidate="/opt/w2/shared/release.candidate-${stamp}.env"
cp /opt/w2/shared/release.env "$backup"
cp /opt/w2/shared/release.env "$candidate"
sed -i \
  -e "s|^W2_PYTHON_IMAGE=.*|W2_PYTHON_IMAGE=${py_ref}|" \
  -e "s|^W2_WEB_IMAGE=.*|W2_WEB_IMAGE=${web_ref}|" \
  -e "s|^W2_GIT_SHA=.*|W2_GIT_SHA=${release_sha}|" \
  -e "s|^W2_BUILD_TIME=.*|W2_BUILD_TIME=${build_time}|" \
  -e "s|^W2_RELEASE_ID=.*|W2_RELEASE_ID=${release_sha}|" \
  -e "s|^W2_SCHEMA_HEAD=.*|W2_SCHEMA_HEAD=${target_head}|" \
  -e "s|^W2_API_IMAGE_ID=.*|W2_API_IMAGE_ID=${python_digest}|" \
  -e "s|^W2_API_OCI_DIGEST=.*|W2_API_OCI_DIGEST=${python_digest}|" \
  -e "s|^W2_API_REGISTRY_DIGEST=.*|W2_API_REGISTRY_DIGEST=${python_digest}|" \
  "$candidate"
for key in W2_PYTHON_IMAGE W2_WEB_IMAGE W2_GIT_SHA W2_BUILD_TIME W2_RELEASE_ID W2_SCHEMA_HEAD W2_API_IMAGE_ID W2_API_OCI_DIGEST W2_API_REGISTRY_DIGEST; do
  grep -Eq "^${key}=.+" "$candidate" || fail "candidate 缺 ${key}"
done

# Stop new lease acquisition before draining existing work. A scheduler kept
# running during this gate can renew the same 15-minute claims indefinitely.
# Candidate identity and source have already been verified; on any subsequent
# failure only paused candidate collectors may resume, never the old services.
pre_schema="$(Q "SELECT version_num FROM alembic_version")"
OLD_STOPPED=1
echo "== stop scheduler before claim drain =="
"${compose[@]}" stop -t 60 scheduler || fail "SCHEDULER_DRAIN_STOP_FAILED"
scheduler_running="$(docker inspect w2-staging-scheduler-1 --format '{{.State.Running}}')"
[ "$scheduler_running" = false ] || fail "SCHEDULER_STILL_RUNNING_BEFORE_DRAIN"
echo "SCHEDULER_OFF_BEFORE_CLAIM_DRAIN=$(date -u +%Y-%m-%dT%H:%M:%SZ)"

echo "== checkpoint gate =="
active_claim_deadline=$(( $(date +%s) + active_claim_max_wait_sec ))
while true; do
  if ! active_claims="$(Q "SELECT count(*) FROM matchday_checkpoint_plans WHERE status='DUE' AND claim_expires_at > now();" 2>/dev/null)"; then
    fail "SWITCH_ACTIVE_CLAIM_QUERY_FAILED"
  fi
  case "$active_claims" in
    ''|*[!0-9]*) fail "SWITCH_ACTIVE_CLAIM_QUERY_INVALID：$active_claims" ;;
  esac
  echo "active_claims=$active_claims"
  [ "$active_claims" = "0" ] && break
  if [ "$(date +%s)" -ge "$active_claim_deadline" ]; then
    fail "SWITCH_BLOCKED_ACTIVE_CLAIM"
  fi
  echo "active_claims 非 0，等待 ${active_claim_poll_sec}s 后重查（最长 ${active_claim_max_wait_sec}s）"
  sleep "$active_claim_poll_sec"
done

echo "== baseline =="
Q "SELECT (SELECT version_num FROM alembic_version), (SELECT count(*) FROM candidate_notification_outbox), (SELECT count(*) FROM recommendations)"
# 记录部署前容器 StartedAt（回读 e 项用）。容器名带连字符（worker-heavy），
# 用 printf -v + ${c//-/_} 生成合法变量名（兼容 bash 3.2，无关联数组）。
# docker inspect 失败时输出可能带换行，一并剥离，避免 eval 把换行后的
# "unknown" 当命令执行。
for c in api web worker worker-heavy scheduler postgres redis; do
  _s="$(docker inspect "w2-staging-${c}-1" --format '{{.State.StartedAt}}' 2>/dev/null || echo 'unknown')"
  _s="${_s//$'\n'/}"
  printf -v "pre_${c//-/_}" '%s' "$_s"
done

# 迁移前基线：旧代码与旧数据库仍然一致。这个响应也是发布后 c/d
# 回读使用的同一工作台接口口径；任何字段缺失都必须在迁移前停止。
echo "== pre-migration dashboard baseline =="
pre_schema="$(Q "SELECT version_num FROM alembic_version" 2>/dev/null || true)"
if [ "$safe_pause_resume" = 1 ]; then
  # Public API remains OFF throughout recovery. Read the same fixture window
  # through the trusted candidate's repository in PostgreSQL read-only mode;
  # do not revive the obsolete API or replace the baseline with an empty list.
  pg_password="$(grep -E '^POSTGRES_PASSWORD=' /opt/w2/shared/.env | head -1 | cut -d= -f2-)"
  pre_workspace_json="$(docker run --rm --network w2-staging_w2-staging \
    -e "W2_DATABASE_URL=postgresql+psycopg://w2_user:${pg_password}@postgres:5432/w2" \
    -e "W2_ENVIRONMENT=staging" \
    --entrypoint python "$py_ref" /app/scripts/w2_safe_pause_identity.py \
    --dashboard-baseline)" || fail "SAFE_PAUSE_DASHBOARD_BASELINE_FAILED"
  echo "SAFE_PAUSE_DASHBOARD_BASELINE $pre_workspace_json"
else
  pre_workspace_json="$(curl -fsS --max-time 90 "http://127.0.0.1:${api_port}/v1/dashboard/intelligence-workspace" 2>/dev/null || true)"
fi
pre_workspace_meta="$(printf '%s' "$pre_workspace_json" | python3 -c '
import json,sys
try:
    d=json.load(sys.stdin)
    matches=d.get("matches")
    football_day=d.get("football_day_start_utc")
    if not isinstance(matches,list) or not isinstance(football_day,str) or not football_day:
        raise ValueError("matches/football_day_start_utc missing or invalid")
    print(len(matches))
    print(football_day)
except Exception as exc:
    print("BASELINE_INVALID:" + str(exc))
    raise SystemExit(1)
' 2>/dev/null || true)"
pre_matches="${pre_workspace_meta%%$'\n'*}"
pre_football_day="${pre_workspace_meta#*$'\n'}"
case "$pre_schema" in ''|*[![:print:]]*) fail "BASELINE_CAPTURE_FAILED pre_schema" ;; esac
case "$pre_matches" in ''|*[!0-9]*) fail "BASELINE_CAPTURE_FAILED pre_matches" ;; esac
case "$pre_football_day" in ''|BASELINE_INVALID:*) fail "BASELINE_CAPTURE_FAILED pre_football_day" ;; esac
echo "PRE_RELEASE_BASELINE pre_schema=${pre_schema} pre_matches=${pre_matches} pre_football_day=${pre_football_day}"

# Stop every old recommendation producer, sender and public reader before
# applying a schema the old processes were never verified against. In-flight
# claims were drained above; queued old tasks are fenced by the new code.
echo "== old recommendation OFF before migration =="
OLD_STOPPED=1
"${compose[@]}" stop -t 60 scheduler worker worker-heavy api web || fail "OLD_RECOMMENDATION_STOP_FAILED"
for c in scheduler worker worker-heavy api web; do
  running="$(docker inspect "w2-staging-${c}-1" --format '{{.State.Running}}' 2>/dev/null || echo unknown)"
  [ "$running" = "false" ] || fail "OLD_RECOMMENDATION_STILL_RUNNING ${c}=${running}"
done
old_off_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "OLD_RECOMMENDATION_OFF_AT=${old_off_at}"
echo "OLD_PENDING_EVENT_COUNTS"
Q "SELECT event_type || ':' || count(*) FROM candidate_notification_outbox WHERE delivery_status IN ('PENDING','RETRY_PENDING') GROUP BY event_type ORDER BY event_type" || fail "OLD_OUTBOX_AUDIT_FAILED"

# Schema and role checks run only after the old recommendation process is OFF.
if [ "$has_migration" = "yes" ]; then
  echo "== migration: alembic upgrade head =="
  # 迁移在 compose 网络内用新镜像跑，需显式注入 DATABASE_URL（否则
  # create_engine() 会回退到默认 SQLite 路径并以非 root 用户失败）。
  # 密码从 shared/.env 读，网络名与 compose 项目 w2-staging 一致。
  pg_password="$(grep -E '^POSTGRES_PASSWORD=' /opt/w2/shared/.env 2>/dev/null | head -1 | cut -d= -f2- || true)"
  db_url="postgresql+psycopg://w2_user:${pg_password}@postgres:5432/w2"
  if docker run --rm --network w2-staging_w2-staging \
      -e "W2_DATABASE_URL=${db_url}" \
      -e "W2_ENVIRONMENT=staging" \
      --entrypoint alembic "$py_ref" upgrade head; then
    migrated="$(Q "SELECT version_num FROM alembic_version")"
    echo "migrated_schema=$migrated"
    [ "$migrated" = "$target_head" ] || fail "迁移后 schema 不等于目标 head：$migrated != $target_head"
    MIGRATION_DONE=1
    echo "MIGRATION_OK $target_head"
  else
    fail "alembic upgrade head 失败（未切换 release.env；数据库可能停在失败迁移之前，需人工处置）"
  fi
fi

# Retire queued V4 messages while every old sender is stopped. The 0087
# trigger permits delivery metadata changes but rejects business-payload
# changes. A delayed old worker task can only reach the new suppression route.
echo "== isolate old recommendation outbox before v3 ON =="
Q "UPDATE candidate_notification_outbox
   SET delivery_status='SUPPRESSED', last_error='HISTORICAL_AH_OU_EVENT'
   WHERE event_type IN ('DAILY_CANDIDATE_LIST','VALIDATION_SAMPLE_CONFIRMED',
                        'VALIDATION_SIGNAL','DAILY_SETTLEMENT')
     AND delivery_status IN ('PENDING','RETRY_PENDING');" >/dev/null \
  || fail "OLD_OUTBOX_SUPPRESSION_FAILED"
old_pending="$(Q "SELECT count(*) FROM candidate_notification_outbox
  WHERE event_type IN ('DAILY_CANDIDATE_LIST','VALIDATION_SAMPLE_CONFIRMED',
                       'VALIDATION_SIGNAL','DAILY_SETTLEMENT')
    AND delivery_status IN ('PENDING','RETRY_PENDING');")" \
  || fail "OLD_OUTBOX_SUPPRESSION_READBACK_FAILED"
[ "$old_pending" = "0" ] || fail "OLD_OUTBOX_PENDING_AFTER_SUPPRESSION:${old_pending}"
echo "OLD_OUTBOX_PENDING_AFTER_SUPPRESSION=0"

# 切换 release.env 之前再查一次评估档位窗口（前 5 / 后 15 分钟）。
# 有冲突就等到下一个空档再切，最多等 60 分钟；超时则停止且不切换。
# 今晚评估档位密集，靠这里自动等空档，而不是靠人工绕过。
if [ "$skip_window" = "0" ]; then
  echo "== 切换前评估档位窗口复查 =="
  wait_deadline=$(( $(date +%s) + gate_max_wait_sec ))
  while true; do
    if ! slot_rows="$(Q "SELECT replace(to_char(scheduled_at AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS'), ' ', 'T') || 'Z' FROM matchday_checkpoint_plans WHERE checkpoint IN ('T3_ODDS','T60_ODDS_LINEUPS','T45_ODDS','T-30m_VALIDATION_LOCK','T15_ODDS') AND scheduled_at >= now() - interval '5 minutes' AND scheduled_at <= now() + interval '15 minutes';" 2>/dev/null)"; then
      fail "切换前评估档位窗口查询失败（fail-closed），拒绝切换"
    fi
    if [ -z "$slot_rows" ]; then
      echo "切换前窗口复查通过（无临近档位）"
      break
    fi
    # 只把合法 ISO 时间行算作冲突档位；其他输出（如 "0"、报错文本）视为
    # 查询返回异常，按 fail-closed 拒绝部署并退出，绝不进入等待循环。
    conflict=0
    while IFS= read -r row; do
      [ -z "$row" ] && continue
      case "$row" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) conflict=1 ;;
        *) fail "切换前评估档位窗口查询返回非法内容（fail-closed）：${row}" ;;
      esac
    done <<< "$slot_rows"
    if [ "$conflict" = "0" ]; then
      echo "切换前窗口复查通过（无临近档位）"
      break
    fi
    if [ "$(date +%s)" -ge "$wait_deadline" ]; then
      fail "切换前评估档位窗口等待超时（${gate_max_wait_sec} 秒），停止且不切换"
    fi
    echo "切换前窗口有冲突（档位：${slot_rows}），等待 ${gate_poll_sec}s 后重试"
    sleep "$gate_poll_sec"
  done
fi

# h 项基线必须在真正切换前记录；发布后只要求 10 分钟内积压数量下降，
# 不再把完全排空作为发布回读条件。
overdue_due_n0="$(Q "SELECT count(*) FROM matchday_checkpoint_plans WHERE checkpoint='POSTMATCH_RESULT' AND status='DUE' AND window_start <= now() - interval '2 hours';")"
case "$overdue_due_n0" in
  ''|*[!0-9]*) fail "切换前逾期 DUE 基线非法：$overdue_due_n0" ;;
esac
echo "POSTMATCH_DRAIN_BASELINE N0=$overdue_due_n0"

echo "== activate release.env =="
install -m 0644 "$candidate" /opt/w2/shared/release.env
ACTIVE=1

echo "== schema assertion =="
schema="$(Q "SELECT version_num FROM alembic_version")"
echo "schema=$schema"
[ "$schema" = "$target_head" ] || fail "schema mismatch: $schema != $target_head"

echo "== recreate worker + worker-heavy + scheduler =="
v3_start_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
[[ "$old_off_at" < "$v3_start_at" || "$old_off_at" = "$v3_start_at" ]] || \
  fail "V3_STARTED_BEFORE_OLD_OFF"
echo "V3_CODE_ACTIVATION_AT=${v3_start_at} OLD_RECOMMENDATION_OFF_AT=${old_off_at}"
"${compose[@]}" up -d --no-deps --force-recreate worker worker-heavy scheduler

echo "== recreate api =="
"${compose[@]}" up -d --no-deps --force-recreate api
ready=0
for _ in $(seq 1 60); do
  if curl -fsS --max-time 5 "http://127.0.0.1:${api_port}/ready" >/dev/null 2>&1; then ready=1; break; fi
  sleep 2
done
[ "$ready" = "1" ] || fail "api /ready 超时"

echo "== recreate web =="
"${compose[@]}" up -d --no-deps --force-recreate web
meta=0
for _ in $(seq 1 30); do
  if curl -fsS --max-time 5 "http://127.0.0.1:${web_port}/meta.json" >/tmp/w2-meta.json 2>/dev/null; then meta=1; break; fi
  sleep 1
done
[ "$meta" = "1" ] || fail "web meta.json 超时"
echo "V3_PUBLIC_ON_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)"

echo "SWITCH_OK backup=$backup"

# 记录部署完成时间（回读 f 项用）
deploy_done="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "deploy_done=$deploy_done"

# 稳定窗口（部署后等待，回读 f 项在窗口后检查 Traceback）
echo "等待 ${stabilize_sec}s 稳定窗口..."
sleep "$stabilize_sec"

# ── 回读（收集全部结果，统一判断）────────────────────────────────────────
set +e
declare -a fails=()
declare -a readback_output=()

rb() {
  local key="$1" ok="$2" detail="$3"
  readback_output+=("[${key}] ${detail}")
  if [ "$ok" = "1" ]; then
    echo "READBACK ${key}=PASS"
  else
    echo "READBACK ${key}=FAIL ${detail}"
    fails+=("${key}")
  fi
}

# a 项前先预热 Dashboard 重查询，只暖缓存、不参与回读判定。
curl -fsS --max-time 90 "http://127.0.0.1:${api_port}/v1/dashboard/summary" >/dev/null 2>&1 || true
curl -fsS --max-time 90 "http://127.0.0.1:${api_port}/v1/dashboard/intelligence-workspace" >/dev/null 2>&1 || true

# a. 六接口 200
a_detail=""
a_ok=1
for p in /v1/version /ready /v1/dashboard /v1/dashboard/summary /v1/dashboard/day-view /v1/dashboard/intelligence-workspace; do
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 90 "http://127.0.0.1:${api_port}${p}")"
  a_detail="${a_detail}${p}=${code} "
  [ "$code" = "200" ] || a_ok=0
done
rb "a" "$a_ok" "$a_detail"

# b. release_id + web/python sha 一致
version_json="$(curl -fsS --max-time 20 "http://127.0.0.1:${api_port}/v1/version" 2>/dev/null)"
meta_json="$(curl -fsS --max-time 20 "http://127.0.0.1:${web_port}/meta.json" 2>/dev/null)"
api_sha="$(printf '%s' "$version_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("api_git_sha",""))' 2>/dev/null)"
rid="$(printf '%s' "$version_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("release_id",""))' 2>/dev/null)"
web_sha="$(printf '%s' "$meta_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("web_git_sha",""))' 2>/dev/null)"
b_ok=1
[ "$rid" = "$release_sha" ] || b_ok=0
[ "$web_sha" = "$api_sha" ] || b_ok=0
rb "b" "$b_ok" "release_id=$rid api_sha=$api_sha web_sha=$web_sha"

# c+d. 工作台（推荐倒序 + 发布前后 matches/足球日对比）
ws_json="$(curl -fsS --max-time 90 "http://127.0.0.1:${api_port}/v1/dashboard/intelligence-workspace" 2>/dev/null)"
current_json="$(curl -fsS --max-time 90 "http://127.0.0.1:${api_port}/v1/dashboard/intelligence-workspace/list" 2>/dev/null)"
# 大盘 JSON 走 argv 会触发 "Argument list too long"（sys.argv 长度上限），
# 落临时文件后按路径读取，避免大 JSON 塞进命令行。
current_file="$(mktemp)"
pre_file="$(mktemp)"
printf '%s' "$current_json" > "$current_file"
printf '%s' "$pre_workspace_json" > "$pre_file"
c_d_result="$(printf '%s' "$ws_json" | python3 -c '
import json,sys
try:
    d=json.load(sys.stdin)
    current=json.load(open(sys.argv[3], encoding="utf-8"))
    before=json.load(open(sys.argv[4], encoding="utf-8"))
except Exception as e:
    print("JSON_ERROR", e); sys.exit(0)
recs=current.get("today_recommendations")
summary=current.get("performance_summary") or {}
c_ok = isinstance(recs,list) and summary.get("schema_version")=="w2.ah_ou_v3_public_performance.v1"
recs=recs if isinstance(recs,list) else []
ids=[r.get("decision_id") for r in recs]
c_ok = c_ok and len(ids)==len(set(ids)) and all(
    r.get("decision_contract")=="w2.ah_ou_decision.v3.1"
    and r.get("market") in ("ASIAN_HANDICAP","TOTALS")
    and r.get("decision_id") for r in recs
)
kicks=[r.get("kickoff_utc") for r in recs if r.get("kickoff_utc")]
noninc = all(kicks[i] <= kicks[i+1] for i in range(len(kicks)-1)) if len(kicks)>1 else True
c_ok = c_ok and noninc
raw_matches=d.get("matches")
matches=raw_matches if isinstance(raw_matches,list) else []
post_matches=len(matches) if isinstance(raw_matches,list) else -1
post_football_day=d.get("football_day_start_utc")
try:
    pre_matches=int(sys.argv[1])
except Exception:
    pre_matches=-1
pre_football_day=sys.argv[2]
now=d.get("generated_at") or ""
from datetime import datetime
def t(s):
    try: return datetime.fromisoformat(str(s).replace("Z","+00:00"))
    except Exception: return None
nowt=t(now)
if not isinstance(post_football_day,str) or not post_football_day:
    d_ok=0
    d_detail="reason=FOOTBALL_DAY_MISSING"
elif pre_football_day != post_football_day:
    d_ok=0
    d_detail=f"reason=FOOTBALL_DAY_ROLLED pre={pre_football_day} post={post_football_day}"
elif pre_matches == 0 and post_matches == 0:
    d_ok=1
    d_detail="mode=EMPTY_BOTH pre=0 post=0 snapshot_check=NOT_APPLICABLE"
    print("WARNING d 的盘口快照子项这次没有检验（发布前后足球日均无比赛）")
elif pre_matches >= 1 and post_matches == 0:
    d_ok=0
    d_detail=f"reason=MATCHES_REGRESSED pre={pre_matches} post=0"
elif post_matches >= 1:
    future=[m for m in matches if t(m.get("kickoff_utc")) is not None and nowt is not None and t(m.get("kickoff_utc")) > nowt]
    sample=future[:3]
    if not sample:
        sample=matches[:3]
    d_ok = int(len(sample) >= 1)
    snaps=[]
    has_snapshot=False
    for m in sample:
        mk=m.get("market_radar",{}).get("markets",{})
        cnts=[v.get("snapshot_count",0) for v in mk.values() if isinstance(v,dict)]
        snaps.append((m.get("fixture_id"), cnts))
        if any(c >= 1 for c in cnts):
            has_snapshot=True
    d_ok = int(d_ok and has_snapshot)
    d_detail=f"mode=SNAPSHOT pre={pre_matches} post={post_matches} sample={snaps}"
    # A release must preserve available data; it cannot create absent Provider
    # quotes. Accept only an unchanged, explicit empty quote baseline for the
    # identical fixture set. Existing snapshot loss and unknown baselines fail.
    def coverage(rows):
        result={}
        for row in rows:
            fixture=row.get("fixture_id")
            radar=row.get("market_radar")
            if not fixture or fixture in result or not isinstance(radar,dict):
                return None
            markets=radar.get("markets")
            if not isinstance(markets,dict):
                return None
            if any(not isinstance(v,dict) for v in markets.values()):
                return None
            counts=[v.get("snapshot_count") for v in markets.values()]
            if any(type(c) is not int or c < 0 for c in counts):
                return None
            result[fixture]=max(counts,default=0)
        return result
    pre_coverage=coverage(before.get("matches",[]))
    post_coverage=coverage(matches)
    if pre_coverage is not None and post_coverage is not None:
        missing=[f for f,n in pre_coverage.items() if n>0 and post_coverage.get(f,0)==0]
        if missing:
            d_ok=0
            d_detail=f"mode=SNAPSHOT reason=AVAILABLE_SNAPSHOT_REGRESSED fixtures={missing}"
        elif (pre_matches==post_matches and pre_matches>0
              and pre_coverage==post_coverage and not any(pre_coverage.values())):
            d_ok=1
            d_detail=(f"mode=UNCHANGED_EMPTY_QUOTES pre={pre_matches} post={post_matches} "
                      "quote_validation=PENDING_SOURCE no_recommendation_inferred=1")
else:
    d_ok=0
    d_detail=f"reason=INVALID_MATCH_COUNTS pre={pre_matches} post={post_matches}"
print(f"c_ok={int(c_ok)} recs={len(recs)} noninc={int(noninc)}")
print(f"d_ok={int(d_ok)} post_matches={post_matches} post_football_day={post_football_day} {d_detail}")
' "$pre_matches" "$pre_football_day" "$current_file" "$pre_file")"
rm -f "$current_file" "$pre_file"
c_ok="$(printf '%s' "$c_d_result" | sed -n 's/^c_ok=\([01]\).*/\1/p' | head -1)"
d_ok="$(printf '%s' "$c_d_result" | sed -n 's/^d_ok=\([01]\).*/\1/p' | head -1)"
rb "c" "$c_ok" "$(printf '%s' "$c_d_result" | grep '^c_ok=' | head -1)"
rb "d" "$d_ok" "$(printf '%s' "$c_d_result" | grep -E '^(d_ok=|WARNING )' | tr '\n' ' ' | sed 's/[[:space:]]*$//')"

# e. 最长 180 秒、每 5 秒轮询全部容器 healthy；全部 healthy 后才判 StartedAt。
e_detail=""
e_ok=1
health_deadline=$(( $(date +%s) + 180 ))
health_ready=0
while true; do
  all_healthy=1
  health_snapshot=""
  for c in api web worker worker-heavy scheduler postgres redis; do
    hs="$(docker inspect "w2-staging-${c}-1" --format '{{.State.Health.Status}}' 2>/dev/null)"
    health_snapshot="${health_snapshot}${c}:${hs:-unknown} "
    [ "$hs" = "healthy" ] || all_healthy=0
  done
  if [ "$all_healthy" = "1" ]; then
    health_ready=1
    break
  fi
  if [ "$(date +%s)" -ge "$health_deadline" ]; then
    e_ok=0
    e_detail="health_timeout_180s ${health_snapshot}"
    break
  fi
  sleep 5
done
if [ "$health_ready" = "1" ]; then
  e_detail="$health_snapshot"
  for c in api web worker worker-heavy scheduler postgres redis; do
    st="$(docker inspect "w2-staging-${c}-1" --format '{{.State.StartedAt}}' 2>/dev/null)"
    pre_var="pre_${c//-/_}"
    pre="${!pre_var}"
    if [ "$c" = "postgres" ] || [ "$c" = "redis" ]; then
      [ "$st" = "$pre" ] || { e_ok=0; e_detail="${e_detail}(postgres/redis 重启!) "; }
    else
      [ "$st" != "$pre" ] || { e_ok=0; e_detail="${e_detail}(${c} 未更新!) "; }
    fi
  done
  for c in worker scheduler; do
    cap="$(docker exec "w2-staging-${c}-1" printenv W2_POSTMATCH_RESULT_DAILY_HARD_CAP 2>/dev/null)"
    e_detail="${e_detail}${c}_postmatch_cap=${cap:-missing} "
    [ "$cap" = "800" ] || e_ok=0
  done
else
  e_ok=0
fi
rb "e" "$e_ok" "$e_detail"

# f. 部署后稳定窗口内 Traceback = 0
f_detail=""
f_ok=1
for c in api worker worker-heavy scheduler; do
  n="$(docker logs --since "$deploy_done" "w2-staging-${c}-1" 2>&1 | grep -c Traceback)"
  f_detail="${f_detail}${c}=${n} "
  [ "$n" = "0" ] || f_ok=0
done
rb "f" "$f_ok" "$f_detail"

# g. The old authority remains OFF after new processes start.
g_n="$(Q "SELECT count(*) FROM candidate_notification_outbox WHERE event_type IN ('DAILY_CANDIDATE_LIST','VALIDATION_SAMPLE_CONFIRMED','VALIDATION_SIGNAL','DAILY_SETTLEMENT') AND created_at >= '${deploy_done}'::timestamptz;")"
g_eval="$(Q "SELECT count(*) FROM dynamic_prematch_evaluations WHERE market IN ('ASIAN_HANDICAP','TOTALS') AND recorded_at >= '${deploy_done}'::timestamptz;")"
g_sample="$(Q "SELECT count(*) FROM validation_samples WHERE projected_at >= '${deploy_done}'::timestamptz;")"
g_cal="$(Q "SELECT count(*) FROM validation_samples_calibrated WHERE projected_at >= '${deploy_done}'::timestamptz;")"
g_ok=1
[ "$g_n" = "0" ] && [ "$g_eval" = "0" ] && [ "$g_sample" = "0" ] && [ "$g_cal" = "0" ] || g_ok=0
rb "g" "$g_ok" "old_outbox=$g_n old_evaluation=$g_eval old_sample=$g_sample old_calibrated=$g_cal"

# h. 最长 10 分钟确认排空在推进：N1 < N0；若切换前 N0=0 则直接通过。
h_ok=1
h_n1="$overdue_due_n0"
if [ "$overdue_due_n0" != "0" ]; then
  deploy_done_epoch="$(date -d "$deploy_done" +%s 2>/dev/null)"
  case "$deploy_done_epoch" in
    ''|*[!0-9]*) h_ok=0 ;;
    *) drain_deadline=$(( deploy_done_epoch + drain_max_wait_sec )) ;;
  esac
  while true; do
    [ "$h_ok" = "1" ] || break
    h_n1="$(Q "SELECT count(*) FROM matchday_checkpoint_plans WHERE checkpoint='POSTMATCH_RESULT' AND status='DUE' AND window_start <= now() - interval '2 hours';")"
    case "$h_n1" in
      ''|*[!0-9]*) h_ok=0; break ;;
    esac
    [ "$h_n1" -lt "$overdue_due_n0" ] && break
    if [ "$(date +%s)" -ge "$drain_deadline" ]; then
      h_ok=0
      break
    fi
    sleep "$drain_poll_sec"
  done
fi
rb "h" "$h_ok" "逾期>2h DUE 排空推进 N0=$overdue_due_n0 N1=$h_n1 max_wait=${drain_max_wait_sec}s"

echo "== 回读汇总 =="
printf '%s\n' "${readback_output[@]}"
if [ "${#fails[@]}" -gt 0 ]; then
  echo "READBACK_FAILED ${fails[*]}"
  exit 1
fi
# 回读全部通过：解除回滚（ACTIVE=0 后 EXIT trap 不再回滚）
ACTIVE=0
OVERRIDE_SYNCED=0
ROLLBACK_NEEDED=0
rm -f "$override_backup" "$override_candidate"
# 唯一成功标记（Mac 端必须看到且 sha 等于目标才判成功）
echo "DEPLOY_COMPLETE $release_sha"
VPS_SCRIPT

rc="${PIPESTATUS[0]}"

# 写 VPS 日志（保留完整输出）
scp_to_vps "$LOCAL_LOG" "$SSH_HOST:/tmp/release-log.tmp" >/dev/null 2>&1
vps "sudo mkdir -p ${VPS_REPORTS_DIR} && sudo cp /tmp/release-log.tmp ${REMOTE_LOG}" >/dev/null 2>&1

if [ "$rc" -ne 0 ]; then
  echo ""
  warn "部署或回读失败（退出码 ${rc}）。不推送、不轮转。"
  warn "完整日志：${LOCAL_LOG}（VPS：${REMOTE_LOG}）"
  warn "发布失败后服务保持安全暂停；禁止以旧镜像重启推荐进程。人工核 schema 与镜像同源后恢复。"
  fail_release "VPS 退出码 ${rc}"
fi

# rc == 0 仍须正向验证成功标记（防止 VPS 提前退出却返回 0 的假成功）
log ""
log "== 5b. 正向成功标记验证 =="
missing_marks=""
mark_missing() { missing_marks="${missing_marks}${missing_marks:+ }$1"; }

grep -qF "SWITCH_OK backup=" "$LOCAL_LOG" 2>/dev/null || mark_missing "SWITCH_OK"
for k in a b c d e f g h; do
  grep -qF "READBACK ${k}=PASS" "$LOCAL_LOG" 2>/dev/null || mark_missing "READBACK_${k}"
done
grep -qF "DEPLOY_COMPLETE ${TARGET}" "$LOCAL_LOG" 2>/dev/null || mark_missing "DEPLOY_COMPLETE"
if [ "$need_backup" = "yes" ]; then
  grep -qF "MIGRATION_OK ${target_head}" "$LOCAL_LOG" 2>/dev/null || mark_missing "MIGRATION_OK"
fi

if [ -n "$missing_marks" ]; then
  fail_release "正向成功标记缺失：${missing_marks}"
fi
if [ "$need_backup" = "yes" ]; then
  log "正向成功标记齐全（SWITCH_OK + READBACK a-h PASS + DEPLOY_COMPLETE + MIGRATION_OK）"
else
  log "正向成功标记齐全（SWITCH_OK + READBACK a-h PASS + DEPLOY_COMPLETE）"
fi

# 推送前独立回读：线上 release_id 必须等于目标 sha
log ""
log "== 5c. 推送前独立回读 /v1/version =="
verify_rid=""
verify_rid="$(read_release_id_with_retry || true)"
if [ "$verify_rid" != "$TARGET" ]; then
  fail_release "线上 release_id 与目标不符：线上=${verify_rid} 期望=${TARGET}"
fi
log "线上 release_id == 目标 sha（${verify_rid}）"

# ─────────────────────────────────────────────────────────────────────────────
# 步骤 6：推送
# ─────────────────────────────────────────────────────────────────────────────
log ""
log "== 6. 推送 =="
"$GIT_CMD" push "$REMOTE" "$BRANCH" || fail_release "git push 失败"
remote_sha="$("$GIT_CMD" ls-remote "$REMOTE" "$BRANCH" 2>/dev/null | awk '{print $1}' | head -1)"
log "远端 sha：$remote_sha"
if [ "$remote_sha" != "$TARGET" ]; then
  fail_release "远端 sha 不一致：远端=${remote_sha} 期望=${TARGET}"
fi
log "远端 sha 一致"

# ─────────────────────────────────────────────────────────────────────────────
# 步骤 7：备份轮转（仅当第 2 步做过备份）
# ─────────────────────────────────────────────────────────────────────────────
log ""
log "== 7. 备份轮转 =="
if [ "$BACKUP_DONE" = "1" ]; then
  # 备份轮转只迁移 Mac 本地旧备份到 U 盘；VPS 本地备份（回滚兜底）不受影响。
  # 部署、回读、推送都已完成，轮转失败（如 U 盘未挂载）只告警，不判发布失败。
  if bash "$BACKUP_ROTATE_SCRIPT"; then
    log "备份轮转完成"
  else
    warn "备份轮转失败（U 盘未挂载或迁移失败）：旧备份保留在本地，不影响本次发布（部署+推送已成功）"
  fi
else
  log "本次未备份，跳过轮转"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 步骤 8：回执
# ─────────────────────────────────────────────────────────────────────────────
log ""
log "== 8. 回执 =="
write_receipt "成功" ""
log "VPS 日志：$REMOTE_LOG"

log ""
log "== w2-release 完成 =="
log "耗时 ${ELAPSED}s"
exit 0
