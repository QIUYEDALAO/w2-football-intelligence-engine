#!/usr/bin/env bash
# Disk, inode and backup-age guard.  Fails closed before a release rather
# than after: a release holds the old image, the running containers, the
# build context, the new image and a predeploy dump on disk at the same
# time, so steady-state free space is not what a release costs.
#
# Registry storage and pg_wal are reported alongside the usual figures
# because both grow without anyone looking at them.  Backup age is here for
# the same reason: a backup that quietly stopped running looks exactly like
# one that never had a problem.
set -uo pipefail

USE=$(df --output=pcent / | tail -1 | tr -dc "0-9")
AVAIL_G=$(( $(df --output=avail / | tail -1) / 1024 / 1024 ))
INODE=$(df --output=ipcent / | tail -1 | tr -dc "0-9")
REG=$(du -sm /var/lib/docker/volumes/*/_data 2>/dev/null | sort -rn | head -1 | cut -f1)
WAL=$(docker exec w2-staging-postgres-1 du -sm /var/lib/postgresql/data/pg_wal 2>/dev/null | cut -f1)

MARKER=/opt/w2/backups/LAST_SUCCESS
if [ -r "$MARKER" ]; then
  AGE_H=$(( ( $(date -u +%s) - $(date -u -d "$(cat "$MARKER")" +%s) ) / 3600 ))
else
  AGE_H=-1
fi

level=OK
if [ "$USE" -gt 70 ] || [ "$AVAIL_G" -lt 8 ]; then level=WARNING; fi
if [ "$AGE_H" -lt 0 ] || [ "$AGE_H" -gt 24 ]; then level=WARNING; fi
if [ "$USE" -gt 80 ] || [ "$AVAIL_G" -lt 5 ]; then level=CRITICAL; fi
if [ "${INODE:-0}" -gt 80 ]; then level=CRITICAL; fi
if [ "$AGE_H" -lt 0 ] || [ "$AGE_H" -gt 72 ]; then level=CRITICAL; fi
if [ "$USE" -gt 90 ] || [ "$AVAIL_G" -lt 3 ]; then level=EMERGENCY; fi

printf "%s disk=%s%% avail=%sG inode=%s%% registry=%sMB wal=%sMB backup_age=%sh\n" \
  "$level" "$USE" "$AVAIL_G" "${INODE:-?}" "${REG:-?}" "${WAL:-?}" "$AGE_H"
if [ "$level" = "OK" ]; then exit 0; fi
logger -t w2-disk-guard "$level disk=${USE}% avail=${AVAIL_G}G inode=${INODE}% backup_age=${AGE_H}h"
if [ "$level" = "WARNING" ]; then exit 1; fi
exit 2
