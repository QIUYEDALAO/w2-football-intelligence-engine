#!/usr/bin/env bash
# Space precheck to run before a release, not after.  A release holds the old
# image, the running containers, the build context, the new image and a
# predeploy dump on disk at the same time, so the question is not whether
# steady-state free space looks healthy.
#
# Budget, measured on this host after the runtime-base split:
#   build context        ~50MB
#   release image layer  ~20MB   (was 530MB while releases were flattened)
#   registry blob        ~20MB
#   predeploy dump       ~90MB
#   safety margin       2048MB
set -uo pipefail

NEED_MB=2228
AVAIL_MB=$(( $(df --output=avail / | tail -1) / 1024 ))
USE=$(df --output=pcent / | tail -1 | tr -dc "0-9")

printf "avail=%sMB need=%sMB use=%s%%\n" "$AVAIL_MB" "$NEED_MB" "$USE"
if [ "$AVAIL_MB" -lt "$NEED_MB" ]; then
  echo "RELEASE_BLOCKED_INSUFFICIENT_DISK"
  exit 2
fi

# A release built on a pre-flatten image cannot mount: that lineage passed the
# overlayfs mount-option limit.  Releases must come from the runtime base.
if ! docker image inspect 127.0.0.1:5000/w2/runtime-base:"${W2_BASE_TAG:-4d5f257daa500878}" >/dev/null 2>&1; then
  echo "RELEASE_BLOCKED_RUNTIME_BASE_MISSING"
  exit 2
fi
echo "PREFLIGHT_OK"
